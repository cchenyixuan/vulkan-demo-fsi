#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "helpers.glsl"
#if WITH_THIN_PLATES
#include "thin_plates.glsl"
#endif

// ============================================================================
// density.comp - δ-plus WCSPH density + pressure update (stage 4 of leapfrog).
//
// Consumes correction outputs (M^-1, ∇ρ) and current-step density
// (density_pressure, the canonical buffer). Runs a 27-voxel neighbor loop per particle to
// compute:
//   density_drift     = Σ_j  -ρ_i · V_j · (v_j - v_i) · ∇W̃_ij
//   density_diffusion = Σ_j   δ · h · c₀ · D_ij           (Antuono δ-SPH)
//   D_ij              = 2 · ψ_ij · (-x_ij · ∇W̃_ij) / (r² + ε_h²) · V_j
//   ψ_ij              = (ρ_j - ρ_i) - 0.5 · (M_i·∇ρ_i + M_j·∇ρ_j) · (-x_ij)
//
//   ∇W̃_ij = M_i · ∇W_ij   (KCG-corrected gradient, using self's correction)
//   x_ij   = r_i - r_j
//
// Forward integration: ρ_{n+1} = ρ_n + dt · (drift + diffusion)
// EOS:                 P_{n+1} = eos_constant · ((ρ_{n+1}/ρ₀)^γ - 1) + p_b
//                      (p_b = BACKGROUND_PRESSURE, 0 by default)
//
// Writes to density_pressure_scratch (binding 2). The simulator's step cmd
// then issues a vkCmdCopyBuffer scratch → primary inside the same submission,
// so by force.comp the canonical density_pressure holds ρ_{n+1}, P_{n+1}.
// No descriptor parity / ping-pong.
//
// Indexing: 1-based throughout. particle_id ∈ [1, OWN+LEADING+TRAILING],
// voxel_id ∈ [1, EXTENDED_VOXEL_COUNT], slot entries are direct 1-based pids.
//
// V1 merged-buffer scheme: own + ghost share set 0 / set 1. Self dispatch
// is bounded to the own pid range via own_first_pid() / own_last_pid().
// Neighbor iteration uses in_own_grid (extended) so ghost neighbors are
// visible automatically.
//
// V1 freshness summary under Option B (single sync after update_voxel +
// ghost_send) at density.comp time:
//   position / velocity / mass / material  : step t  (own + ghost agree)
//   density (ρ)                              : step t-1 (own + ghost agree;
//                                              this kernel is ABOUT to write
//                                              step t)
//   correction_inverse                       : own = step t (correction.comp
//                                              just wrote it),
//                                              GHOST = step t-1 (peer hadn't
//                                              run correction.comp yet at
//                                              ghost_send time)
//   density_gradient_kernel_sum              : own = step t, ghost = step t-1
//
// Self uses its own correction (step t fresh) for `corrected_gradient`.
// Neighbor's correction is read inside the if (USE_KCG_CORRECTION) branch
// and currently flows ONLY into the ψ_ij second term, which is commented
// out — so neighbor's stale ghost correction is effectively dead code.
// As long as the ψ_ij second term stays commented, USE_KCG_CORRECTION can
// be toggled freely without introducing ghost-staleness mismatch.
// Uncommenting the second term turns ghost staleness into a real ~1e-4
// error and motivates Option D (V1.0a/V1.1).
// ============================================================================

layout(local_size_x_id = 51, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// Main
// ============================================================================
void main() {
    // 0-based invocation → 1-based particle_id, offset into own pid range.
    uint self_particle_id = gl_GlobalInvocationID.x + own_first_pid();

    // Padding threads (dispatch rounds up to WORKGROUP_SIZE): early-return.
    if (self_particle_id > own_last_pid()) return;

    // Read material params (used for EOS at end) and skip inlet particles
    // (their state has no SPH meaning; they never appear as neighbors per the
    // InsideParticleIndexBuffer invariants in common.glsl).
    uint self_group_id = material[self_particle_id];
    MaterialParameters self_params = material_parameters[self_group_id];
    if (self_params.kind == MATERIAL_INLET) return;

    // --- Read self state -----------------------------------------------------
    vec4  self_position_voxel_id = position_voxel_id[self_particle_id];
    vec3  self_position          = self_position_voxel_id.xyz;
    uint  self_voxel_id          = uint(round(self_position_voxel_id.w));
    if (self_voxel_id == VOXEL_ID_DEAD) return;

    vec3  self_velocity = velocity_mass[self_particle_id].xyz;
    float self_density  = density_pressure[self_particle_id].x;   // ρ_n
    // shift transport (SHIFT_TRANSPORT_MODE, common.glsl): shift_n, the
    // displacement predict.comp applied in this step
    vec3  self_shift    = (SHIFT_TRANSPORT_MODE != 0u) ? shift[self_particle_id].xyz : vec3(0.0);
    float density_shift_transport   = 0.0;     // -rho_i sum_j V_j (dx_j - dx_i) . gradW~
    vec3  velocity_shift_transport  = vec3(0.0); // (1/rho_i) sum_j V_j (rho_i v_i + rho_j v_j)(dx_ij . gradW), pair form

#if WITH_THIN_PLATES
    // Thin plates (2026-09-30): a plate particle keeps rho0 and its marker.
    if (is_thin_plate_particle(density_pressure[self_particle_id].y)) {
        density_pressure_scratch[self_particle_id] = density_pressure[self_particle_id];
        return;
    }
    gather_near_thin_plates(self_position);
#endif

    // KCG correction matrix and density gradient from correction.comp output.
    // When USE_KCG_CORRECTION is false (ablation), substitute identity / zero
    // — reduces this kernel to plain δ-SPH (Antuono 2012) without the kernel
    // gradient correction. The branch is on a spec constant, so glslc -O
    // dead-code-eliminates one side at compile time (no runtime cost).
    mat3 self_correction_matrix;
    vec3 self_density_gradient;
    if (USE_KCG_CORRECTION) {
        self_correction_matrix = unpack_correction_inverse(self_particle_id);
        self_density_gradient  = density_gradient_kernel_sum[self_particle_id].xyz;
    } else {
        self_correction_matrix = mat3(1.0);
        self_density_gradient  = vec3(0.0);
    }

    // Corrected self density gradient (loop-invariant)
    vec3 self_corrected_density_gradient = self_correction_matrix * self_density_gradient;

    // --- Decode self voxel coord ---------------------------------------------
    ivec3 self_voxel_coord = own_coord_of(self_voxel_id);

    // --- Accumulators --------------------------------------------------------
    // Scalar SGS (2026-09-27): velocity gradient of a FLUID particle,
    //     G = grad v_i = sum_j V_j (v_j - v_i) (x) M_i^-1 grad W_ij
    //       = [sum_j V_j (v_j - v_i) (x) grad W_ij] M_i^-1        (M symmetric)
    // with the stored KCG inverse (M + xi I)^-1. With xi = 0.01 it is 0.8 %
    // smaller than M^-1 on the h/dx = 3 lattice, so the gradient is first-order
    // consistent to that accuracy (until 2026-09-28 xi was 0.1, the stored
    // inverse 7.6 % too small, and a helper undid the regularisation here).
    // The raw sum is accumulated in the loop
    // (it needs exactly the neighbour velocity and volume this kernel already
    // reads) and multiplied by M_i^-1 once afterwards. Solid neighbours are
    // included: their (wall or rotor) velocity is the no-slip boundary value.
    // Dead code unless USE_SCALAR_SGS.
    bool self_is_fluid = (self_params.kind == MATERIAL_FLUID);
    mat3 velocity_gradient = mat3(0.0);

    float density_drift     = 0.0;
    float density_diffusion = 0.0;
    // SOLID_PRESSURE_MODE 4 (extrapolate), solid self: kernel-weighted sums over
    // the fluid neighbours.
    bool  self_is_solid = is_solid_kind(self_params.kind);
    float extrapolation_weight_sum   = 0.0;
    float extrapolation_pressure_sum = 0.0;
    vec3  extrapolation_offset_sum   = vec3(0.0);     // sum_f rho_f (x_s - x_f) W_sf

    // ------------------------------------------------------------------------
    // Neighbour loop (2026-09-25). Two candidate sources, chosen at pipeline
    // creation by USE_NEIGHBOR_LIST (the other branch is dead code):
    //   list mode : one "cell" = this particle's row of the per-step
    //               neighbour list (build_neighbor_list.comp); every entry
    //               already passed the support test, nothing is filtered here.
    //   voxel mode: 27 cells (9 in 2D) = the surrounding voxels, walked
    //               z-slowest / x-fastest exactly like the original triple
    //               loop; the support test is applied per candidate.
    // Both modes visit the same pairs in the same order, so their sums agree
    // to floating-point rounding.
    // ------------------------------------------------------------------------
    uint cell_count = USE_NEIGHBOR_LIST ? 1u : (NEIGHBOR_Z_RANGE == 0u ? 9u : 27u);
    for (uint cell = 0u; cell < cell_count; cell++) {
        uint candidate_count;
        uint candidate_base = 0u;   // voxel mode: flat index of the voxel's slot 0
        if (USE_NEIGHBOR_LIST) {
            candidate_count = neighbor_count[self_particle_id];
        } else {
            ivec3 delta = ivec3(int(cell % 3u) - 1,
                                int((cell / 3u) % 3u) - 1,
                                int(cell / 9u) - int(NEIGHBOR_Z_RANGE));
            ivec3 neighbor_coord = self_voxel_coord + delta;
            if (!in_own_grid(neighbor_coord)) continue;
            uint neighbor_voxel_id = own_voxel_id_of(neighbor_coord);
            candidate_count = inside_particle_count[neighbor_voxel_id];
            candidate_base  = neighbor_voxel_id * MAX_PARTICLES_PER_VOXEL;
        }

        for (uint candidate = 0u; candidate < candidate_count; candidate++) {
            uint neighbor_particle_id;
            if (USE_NEIGHBOR_LIST) {
                neighbor_particle_id = neighbor_list[candidate * neighbor_list_stride() + self_particle_id];
            } else {
                neighbor_particle_id = inside_particle_index[candidate_base + candidate];
                if (neighbor_particle_id == INSIDE_SLOT_EMPTY) break;
                if (neighbor_particle_id == self_particle_id) continue;
            }

            // Skip boundary↔boundary pair when self is boundary. The
            // boundary's per-step new_density (and the new_pressure
            // derived from it via EOS) should reflect ONLY fluid
            // neighbor influence, not artifacts from other boundaries
            // — those are static and contribute zero divergence but
            // their kernel-deficient drift terms still feed back into
            // the boundary's apparent pressure. Branch is uniform per
            // workgroup since voxel-sorted boundaries cluster together.
            // ROTOR counts as a wall here too (2026-09-25): a rotor
            // particle's density must reflect only fluid neighbours,
            // not other rotor / boundary particles (rotor-rotor pairs
            // have zero relative velocity anyway; rotor-wall pairs at
            // the shaft / lid crossing would otherwise inject noise).
            if (is_solid_kind(self_params.kind)) {
                uint neighbor_group_id = material[neighbor_particle_id];
                if (is_solid_kind(material_parameters[neighbor_group_id].kind)) continue;
            }

            // --- Distance check (Wendland C4 support = h) -----------
            // Neighbor is guaranteed non-inlet / non-dead by InsideParticleIndexBuffer invariants.
            vec3  neighbor_position = position_voxel_id[neighbor_particle_id].xyz;
            vec3  position_difference_neighbor_to_self = self_position - neighbor_position; // x_ij
            // Squared test first (2026-09-25): the sqrt is only paid for
            // the ~15 % of candidates inside the support, not for all 27
            // voxels' worth. Same accept set as `length(x) >= h` up to
            // rounding at q = 1 where W and grad W are exactly 0 anyway.
            float distance_squared = dot(position_difference_neighbor_to_self, position_difference_neighbor_to_self);
            if (!USE_NEIGHBOR_LIST) {
                if (distance_squared >= smoothing_length_squared() || distance_squared < 1e-24) continue;
            }
            float distance = sqrt(distance_squared);

            // --- Read neighbor state --------------------------------
            vec3  neighbor_velocity = velocity_mass[neighbor_particle_id].xyz;
            float neighbor_mass     = velocity_mass[neighbor_particle_id].w;
            vec2  neighbor_density_pressure = density_pressure[neighbor_particle_id];
            float neighbor_density  = neighbor_density_pressure.x;
            float neighbor_volume   = neighbor_mass / neighbor_density;
#if WITH_THIN_PLATES
            // A neighbour behind a plate (a plate particle, or any particle whose
            // segment to this one crosses the plate) is a dummy particle of the wall:
            // it moves with the plate and takes no part in the density diffusion.
            bool neighbor_is_wall_dummy = false;
            if (near_thin_plate_count > 0u) {
                uint wall_slot = thin_plate_wall_slot(self_position, neighbor_position,
                                                      neighbor_density_pressure.y);
                if (self_is_solid) {
                    // the fluid behind a plate does not reach an ordinary solid particle
                    if (wall_slot != MAX_NEAR_THIN_PLATES) continue;
                } else if (wall_slot != MAX_NEAR_THIN_PLATES) {
                    neighbor_is_wall_dummy = true;
                    neighbor_velocity = thin_plate_velocity(wall_slot, neighbor_position);
                } else if (is_thin_plate_particle(neighbor_density_pressure.y)) {
                    continue;
                }
            }
#endif
            if (SOLID_PRESSURE_MODE == 4u && self_is_solid) {
                // only fluid neighbours reach this point for a solid self
                float kernel_value = evaluate_kernel(distance);
                extrapolation_weight_sum   += kernel_value;
                extrapolation_pressure_sum += neighbor_density_pressure.y * kernel_value;
                extrapolation_offset_sum   += neighbor_density * position_difference_neighbor_to_self * kernel_value;
            }

            // Read neighbor correction matrix and density gradient
            // (or identity / zero when KCG ablated; spec-const DCE'd).
            mat3 neighbor_correction_matrix;
            vec3 neighbor_density_gradient;
            if (USE_KCG_CORRECTION) {
                neighbor_correction_matrix = unpack_correction_inverse(neighbor_particle_id);
                neighbor_density_gradient  = density_gradient_kernel_sum[neighbor_particle_id].xyz;
            } else {
                neighbor_correction_matrix = mat3(1.0);
                neighbor_density_gradient  = vec3(0.0);
            }

            // --- Kernel gradient: raw then M_i-corrected ------------
            vec3 raw_gradient        = evaluate_kernel_gradient_unguarded(position_difference_neighbor_to_self, distance);
            vec3 corrected_gradient  = self_correction_matrix * raw_gradient;

            // --- Scalar SGS: raw velocity-gradient sum (see declaration above)
            // outerProduct(c, r) = c r^T, so velocity_gradient[b][a] = sum of
            // (v_j - v_i)_a (grad W)_b in GLSL's column-major indexing, i.e. the
            // usual (d v_a / d x_b) layout once multiplied by M^-1 below.
            if ((USE_SCALAR_SGS || USE_MOMENTUM_SGS) && self_is_fluid) {
                velocity_gradient += neighbor_volume
                    * outerProduct(neighbor_velocity - self_velocity, raw_gradient);
            }

            // --- δ-SPH density diffusion (gated by USE_DENSITY_DIFFUSION) -
            // Spec-const branch: glslc -O DCE-removes the entire body when
            // USE_DENSITY_DIFFUSION = false → vanilla WCSPH continuity.
#if WITH_THIN_PLATES
            if (USE_DENSITY_DIFFUSION && !neighbor_is_wall_dummy) {
#else
            if (USE_DENSITY_DIFFUSION) {
#endif
                // --- ψ_ij ---------------------------------------------------
                // V0 simplification: ψ_ij = (ρ_j - ρ_i) only (linear form).
                // Full Antuono δ-plus formulation also includes an antisymmetric
                // density-gradient projection term that improves accuracy near
                // sharp density jumps:
                //   ψ_ij = (ρ_j - ρ_i) - 0.5 · (M_i·∇ρ_i + M_j·∇ρ_j) · (-x_ij)
                // The second term is intentionally commented out for V0 to keep
                // the operator simple while validating the rest of the pipeline.
                // The supporting computations below (corrected gradient sums) are
                // also kept so the second term can be restored by uncommenting.
                //
                // V1 STALENESS NOTE: while the second term stays commented out,
                // neighbor_correction_matrix and neighbor_density_gradient flow
                // only into corrected_density_gradient_sum, which is dead code
                // (glslc -O should DCE the entire chain). This shields V1 from
                // the fact that ghost neighbours' correction_inverse and
                // density_gradient_kernel_sum are 1 step stale under Option B
                // single sync. UNCOMMENTING the second term turns those reads
                // live and exposes the staleness as a ~1e-4 error in ψ_ij —
                // would require Option D double sync (V1.0a/V1.1) or accepting
                // the bias.
                vec3 neighbor_corrected_density_gradient = neighbor_correction_matrix * neighbor_density_gradient;
                vec3 corrected_density_gradient_sum = self_corrected_density_gradient + neighbor_corrected_density_gradient;
                vec3 position_difference_self_to_neighbor = -position_difference_neighbor_to_self; // -x_ij
                float psi_ij = (neighbor_density - self_density);// - 0.5 * dot(corrected_density_gradient_sum, position_difference_self_to_neighbor);
                if (USE_DENSITY_DIFFUSION_GRADIENT_TERM) {
                    psi_ij -= 0.5 * dot(corrected_density_gradient_sum, position_difference_self_to_neighbor);
                }
                // 2026-09-29, mirrored solid pressure: the solid neighbours keep rho0 here.
                // rho0 - rho_i pulls the density of the fluid next to a solid toward rho0;
                // it is a pressure sink under gravity, but it is also what absorbs the
                // density drift of the particle shift (the shift moves particles without
                // a term in the continuity equation). Both alternatives were tried on a
                // box at rest under gravity and drifted: zero flux to solids (pressure
                // -1700 Pa in 0.075 s, then the fluid entered the walls) and the density
                // continued with the body force (pressure +250 Pa in 0.015 s).
                // log/2026-09-29_mirrored-solid-pressure.md.
                // --- D_ij = 2·ψ_ij · (-x_ij · ∇W̃_ij) / (r² + ε_h²) · V_j ---
                float dot_xji_gradient = dot(position_difference_self_to_neighbor, corrected_gradient);
                float d_ij = 2.0 * psi_ij * dot_xji_gradient / (distance * distance + EPS_H_SQUARED) * neighbor_volume;

                // --- Diffusion accumulator: δ · h · c₀ · D_ij ---------
                density_diffusion += DELTA_COEFFICIENT * SMOOTHING_LENGTH * SPEED_OF_SOUND * d_ij;
            }

            // --- Drift: -ρ_i · V_j · (v_j - v_i) · ∇W̃_ij -----------
            density_drift += -self_density * neighbor_volume * dot(neighbor_velocity - self_velocity, corrected_gradient);

            // --- Shift transport (2026-09-30, see SHIFT_TRANSPORT_MODE) ---
            if (SHIFT_TRANSPORT_MODE != 0u && !self_is_solid) {
                vec3 neighbor_shift = shift[neighbor_particle_id].xyz;   // 0 for solids (force.comp writes 0)
#if WITH_THIN_PLATES
                if (neighbor_is_wall_dummy) neighbor_shift = vec3(0.0);
#endif
                density_shift_transport  += -self_density * neighbor_volume * dot(neighbor_shift - self_shift, corrected_gradient);
                // pair form F_ij = V_i V_j (rho_i v_i + rho_j v_j)(dx_ij . gradW_ij) = -F_ji: linear momentum
                // is conserved exactly (raw gradient, exactly antisymmetric); in the interior it equals
                // (dx . grad) v. The advective form sum V_j (v_j - v_i)(dx_ij . gradW~) is not a pair force
                // and removed 25 % of the rotor's angular momentum input (3 mm tank, 2026-09-30).
                velocity_shift_transport += neighbor_volume * (neighbor_density * neighbor_velocity + self_density * self_velocity)
                                          / self_density * dot(0.5 * (self_shift + neighbor_shift), raw_gradient);
            }
        }
    }

    // ========================================================================
    // Forward integration (full dt; leapfrog only staggers v, not ρ).
    // ========================================================================
    float new_density = self_density + TIMESTEP * (density_drift + density_diffusion);
    if ((SHIFT_TRANSPORT_MODE & 1u) != 0u && !self_is_solid) {
        new_density += density_shift_transport;          // a displacement, not a rate: no dt
    }
    if ((SHIFT_TRANSPORT_MODE & 2u) != 0u && !self_is_solid) {
        // handed to force.comp as an acceleration dv / dt in the slot force.comp
        // overwrites at its end (predict.comp has already consumed a_n of this
        // slot; each kernel writes its own slot only, so there is no race)
        acceleration[self_particle_id] = vec4(velocity_shift_transport / TIMESTEP, 0.0);
    }

    // ========================================================================
    // Tait EOS: P = eos_constant · ((ρ/ρ₀)^γ - 1) + p_b
    // ========================================================================
    if (self_is_solid && SOLID_PRESSURE_MODE == 3u && SOLID_DENSITY_FLOOR) {
        // accumulate: the solid keeps its density, never below rho0 (see SOLID_DENSITY_FLOOR)
        new_density = max(new_density, self_params.rest_density);
    }
    float density_ratio = new_density / self_params.rest_density;
    float new_pressure  = self_params.eos_constant * (pow(density_ratio, POWER_PARAMETER) - 1.0)
                        + BACKGROUND_PRESSURE;
    if (self_is_solid && SOLID_PRESSURE_MODE == 4u) {
        // extrapolate: pressure of the fluid continued to the solid particle
        if (extrapolation_weight_sum > 1e-12) {
            vec3 relative_body_force = vec3(GRAVITY_X, GRAVITY_Y, GRAVITY_Z)
                - solid_particle_acceleration(self_params.kind, self_position);
            new_pressure = (extrapolation_pressure_sum + dot(relative_body_force, extrapolation_offset_sum))
                         / extrapolation_weight_sum;
        } else {
            new_pressure = BACKGROUND_PRESSURE;
        }
        float pressure_ratio = max(1.0 + (new_pressure - BACKGROUND_PRESSURE) / self_params.eos_constant, 0.1);
        new_density = self_params.rest_density * pow(pressure_ratio, 1.0 / POWER_PARAMETER);
    }

    // ========================================================================
    // Write to scratch (simulator copies scratch → primary right after this
    // dispatch returns).
    //
    // Boundary handling: store ρ₀ instead of the integrated new_density so that
    // boundary particles' density does NOT accumulate step-to-step (this is
    // what kills the boundary density drift). The pressure stored is still the
    // freshly-computed new_pressure (= EOS(new_density)) — force.comp this step
    // reads it for fluid↔boundary pressure interactions, so the boundary still
    // reacts to local pressure conditions. Next step's density.comp reads back
    // ρ₀ for the boundary source density (no drift), and force.comp computes
    // V_j_boundary = m / ρ₀ = V_calibrated (constant, physically correct for
    // a static solid). Matches the legacy "property buffer = ρ₀ forever,
    // runtime buffer = per-step new_pressure" architecture.
    // ========================================================================
    // ROTOR: same treatment as BOUNDARY (2026-09-25) — it is a moving wall;
    // its pressure still comes from the per-step new_density, which includes
    // the fluid-relative velocity divergence term, so fluid approaching a
    // blade sees a rising pressure exactly as at a static wall.
    // 2026-09-29: SOLID_PRESSURE_MODE 3 (accumulate) and 4 (extrapolate) store the
    // solid's own density, so that the fluid sees a solid at the density that
    // belongs to its pressure (volume, density diffusion).
    float density_to_store = (self_is_solid && SOLID_PRESSURE_MODE != 3u && SOLID_PRESSURE_MODE != 4u)
        ? self_params.rest_density
        : new_density;
    density_pressure_scratch[self_particle_id] = vec2(density_to_store, new_pressure);

    // ========================================================================
    // Scalar SGS (2026-09-27): Smagorinsky eddy viscosity of FLUID particles
    //     S    = (G + G^T) / 2
    //     |S|  = sqrt(2 S:S)
    //     nu_t = (C_s Delta)^2 |S|        (SGS_LENGTH_SQUARED = (C_s Delta)^2)
    // Read by force.comp later in this step (scalar diffusion only).
    // ========================================================================
    if ((USE_SCALAR_SGS || USE_MOMENTUM_SGS) && self_is_fluid) {
        if (USE_KCG_CORRECTION) {
            velocity_gradient = velocity_gradient * self_correction_matrix;
        }
        mat3  strain_rate = 0.5 * (velocity_gradient + transpose(velocity_gradient));
        float strain_rate_contracted = dot(strain_rate[0], strain_rate[0])
                                     + dot(strain_rate[1], strain_rate[1])
                                     + dot(strain_rate[2], strain_rate[2]);   // S:S
        // momentum SGS (2026-10-01): its own (C_s Delta)^2, see USE_MOMENTUM_SGS
        turbulent_viscosity[self_particle_id] =
            (USE_MOMENTUM_SGS ? MOMENTUM_SGS_LENGTH_SQUARED : SGS_LENGTH_SQUARED) * sqrt(2.0 * strain_rate_contracted);
    }
}
