#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "helpers.glsl"

// ============================================================================
// predict.comp - leapfrog kick + drift + voxel-crossing detection (stage 1).
//
// For each active fluid particle:
//   1. Leapfrog kick   : v_{n+1/2} = v_{n-1/2} + a_n · dt
//   2. Drift           : x_{n+1}   = x_n + v_{n+1/2} · dt + shift_n
//   3. Voxel crossing  : compute new voxel_id; if != old, atomic-append particle_id
//                        to incoming_particle_index of the new voxel.
//   4. Open boundary   : if new position lies outside the EXTENDED grid (own +
//                        ghost columns), kill the particle (zero pos + vel,
//                        voxel_id = 0). Under CFL, drift per step ≤ 1 voxel,
//                        so this only fires at the physical domain edge of an
//                        end-of-chain GPU's outward side.
//
// Skipped kinds: BOUNDARY (static), INLET (emitter). Dead particles (old
// voxel_id = 0) also skip.
//
// ROTOR kind (2026-09-25): prescribed rigid-body rotation instead of the
// leapfrog kick/drift. The particle is placed at
//     x_{n+1} = pivot + R(theta_{n+1}) (x_ref - pivot)
// with x_ref = extension_fields.xyz (its initial position) and theta from
// RotorStateBuffer (cos/sin written by the CPU each step, accumulated in
// float64 there — no per-step incremental rotation, so the radius of every
// rotor particle is preserved to float32 round-off for any number of steps).
// Its velocity is the rigid-body velocity omega * axis x (x_{n+1} - pivot),
// stored in velocity_mass.xyz so that force.comp's viscous term and
// density.comp's continuity term see the moving wall (no-slip is automatic).
// acceleration / shift of a rotor particle are ignored here (force.comp still
// computes its acceleration = fluid force per unit mass, which the CPU reads
// back for the torque). Voxel-crossing bookkeeping is identical to fluid.
//
// Scalar transport (2026-09-27), FLUID particles only:
//   C_{n+1} = C_n + scalar_delta_n   (ΔC from the previous force.comp: diffusion
//             over dt plus the shift correction that matches the shift added
//             to x above), accumulated with Kahan compensation unless the
//             ablation toggle USE_SCALAR_COMPENSATED_SUM is off. Then, if a
//             tracer pulse is active and x_{n+1} lies inside its sphere, the
//             targeted field is set to the pulse value (and its compensation
//             cleared). Killed particles skip the update (their slot is dead).
//
// Data flow:
//   acceleration[pid]  : written by previous step's force.comp  (a_n)
//   shift[pid]         : written by previous step's force.comp  (shift_n, already M_i-corrected)
//   position_voxel_id  : read (x_n + old vid) → write (x_{n+1} + new vid)
//   velocity_mass.xyz  : read (v_{n-1/2}) → write (v_{n+1/2}); mass preserved
//
// Voxel buffer writes:
//   incoming_particle_count[new_vid]  : atomicAdd +1 on crossing
//   incoming_particle_index[...]      : atomic append (if within CAP)
//   On overflow (slot >= CAP): log to GlobalStatus, kill particle.
//
// Invariant for downstream update_voxel.comp:
//   - incoming_particle_count may exceed MAX_INCOMING_PER_VOXEL after overflow;
//     update_voxel MUST clamp its iteration bound to min(count, CAP).
//   - Dead particles (killed here) have position_voxel_id.w = 0, so update_voxel
//     automatically compacts them out of inside_particle_index.
//
// V1.0a path 2: new_voxel_id may fall in own range OR in leading/trailing
// ghost range. Both atomic-append to incoming_particle_index[new_voxel_id]
// without distinction. Downstream consumes them differently:
//   - own voxel incoming → consumed by update_voxel.comp (rebuilds own inside list)
//   - ghost voxel incoming → consumed by ghost_send.comp as MIGRATION packet
//     source (own particles that drifted across the partition); ghost_send
//     marks the own pid dead after packing.
// predict does NOT differentiate; it just records the new voxel and trusts
// the downstream classification.
// ============================================================================

layout(local_size_x_id = 51, local_size_y = 1, local_size_z = 1) in;

// Zero out particle state on death. Stale shift / acceleration / density fields
// remain in their buffers, but voxel_id == 0 gates all downstream kernels from
// reading them. Slot stays unused until future inlet spawn / defrag reclaims it.
void kill_particle(uint particle_id) {
    position_voxel_id[particle_id] = vec4(0.0);
    velocity_mass[particle_id]     = vec4(0.0);
}

void main() {
    uint self_particle_id = gl_GlobalInvocationID.x + own_first_pid();
    if (self_particle_id > own_last_pid()) return;

    // --- Material kind gate: skip all non-fluid kinds in V0 ------------------
    uint self_group_id = material[self_particle_id];
    MaterialParameters self_params = material_parameters[self_group_id];
    if (self_params.kind == MATERIAL_BOUNDARY) return;   // static walls
    if (self_params.kind == MATERIAL_INLET)    return;   // emitter templates
    bool is_rotor = (self_params.kind == MATERIAL_ROTOR);

    // --- Read self position + voxel_id ---------------------------------------
    vec4 self_position_voxel_id = position_voxel_id[self_particle_id];
    vec3 self_position          = self_position_voxel_id.xyz;
    uint old_voxel_id           = uint(round(self_position_voxel_id.w));
    if (old_voxel_id == VOXEL_ID_DEAD) return;   // already dead

    // --- Read velocity + mass + acceleration + shift -------------------------
    vec4  self_velocity_mass = velocity_mass[self_particle_id];
    vec3  self_velocity_half = self_velocity_mass.xyz;          // v_{n-1/2}
    float self_mass          = self_velocity_mass.w;

    vec3  self_acceleration  = acceleration[self_particle_id].xyz;  // a_n
    vec3  self_shift         = shift[self_particle_id].xyz;          // shift_n (M_i-corrected)

    // ========================================================================
    // Leapfrog kick (full-step, combining Verlet KDK's two half-kicks):
    //     v_{n+1/2} = v_{n-1/2} + a_n · dt
    // ========================================================================
    vec3 new_velocity = self_velocity_half + self_acceleration * TIMESTEP;

    // ========================================================================
    // Drift:
    //     x_{n+1} = x_n + v_{n+1/2} · dt + shift_n
    // ========================================================================
    vec3 new_position = self_position + new_velocity * TIMESTEP + self_shift;

    // ========================================================================
    // ROTOR: overwrite kick + drift with the prescribed rigid-body motion.
    // ========================================================================
    if (is_rotor) {
        vec3 rotor_axis  = normalize(vec3(ROTOR_AXIS_X, ROTOR_AXIS_Y, ROTOR_AXIS_Z));
        vec3 rotor_pivot = vec3(ROTOR_PIVOT_X, ROTOR_PIVOT_Y, ROTOR_PIVOT_Z);
        vec3 reference_arm = extension_fields[self_particle_id].xyz - rotor_pivot;
        vec3 rotated_arm   = rotate_about_axis(reference_arm, rotor_axis,
                                               rotor_cos_theta, rotor_sin_theta);
        new_position = rotor_pivot + rotated_arm;
        new_velocity = rotor_angular_velocity_now * cross(rotor_axis, rotated_arm);
    }

    // ========================================================================
    // Determine new voxel_id.
    // Spatial coord is 0-based; convert via OWN_ORIGIN + SMOOTHING_LENGTH lattice.
    // ========================================================================
    vec3  own_origin = vec3(OWN_ORIGIN_X, OWN_ORIGIN_Y, OWN_ORIGIN_Z);
    ivec3 new_voxel_coord  = ivec3(floor((new_position - own_origin) / SMOOTHING_LENGTH));

    // Case C: drifted out of domain → kill (open boundary).
    if (!in_own_grid(new_voxel_coord)) {
        kill_particle(self_particle_id);
        return;
    }

    uint new_voxel_id = own_voxel_id_of(new_voxel_coord);

    // ========================================================================
    // Case B: voxel changed → atomic-append to new voxel's incoming queue.
    // new_voxel_id may be own or ghost; ghost_send.comp consumes ghost-voxel
    // incoming as migration source (V1.0a path 2).
    // ========================================================================
    if (new_voxel_id != old_voxel_id) {
        uint slot = atomicAdd(incoming_particle_count[new_voxel_id], 1u);
        if (slot >= MAX_INCOMING_PER_VOXEL) {
            // Incoming buffer full for target voxel → log + kill.
            // Counter stays past CAP (update_voxel clamps on read).
            // CompSwap below stores ONE example overflow voxel (race winner
            // when the field is still 0); subsequent overflows cannot overwrite.
            atomicAdd(overflow_incoming_count, 1u);
            atomicCompSwap(first_overflow_voxel_incoming, 0u, new_voxel_id);
            kill_particle(self_particle_id);
            return;
        }
        incoming_particle_index[new_voxel_id * MAX_INCOMING_PER_VOXEL + slot] = self_particle_id;
    }
    // Case A: new_voxel_id == old_voxel_id → no atomic op; particle stays in
    // the current voxel's inside list and update_voxel sees no change.

    // ========================================================================
    // Scalar transport (2026-09-27): apply the increment force.comp prepared,
    // then any active tracer pulse. FLUID only (rotor particles return above
    // only for the kick/drift part, so they are excluded explicitly).
    // ========================================================================
    if (SCALAR_VEC4_COUNT > 0u && !is_rotor) {
        for (uint vec4_index = 0u; vec4_index < SCALAR_VEC4_COUNT; vec4_index++) {
            uint index = scalar_index(self_particle_id, vec4_index);
            vec4 delta = scalar_delta[index];
            precise vec4 value = scalar[index];
            // Continuous sources (2026-10-01): every FLUID particle inside the sphere at x_{n+1}
            // gains value.x; the recording field (value.y - 1) gains the same amount.
            if (USE_SCALAR_INJECTION) {
                for (uint slot_index = 0u; slot_index < MAX_INJECTION_SLOTS; slot_index++) {
                    ScalarInjectionSlot slot = scalar_injection[slot_index];
                    if (slot.target.x == 0u || slot.target.y != vec4_index || slot.target.w != 1u) continue;
                    vec3 offset = new_position - slot.center_radius_squared.xyz;
                    if (dot(offset, offset) < slot.center_radius_squared.w) {
                        delta[min(slot.target.z, 3u)] += slot.value.x;
                        uint record = uint(max(slot.value.y, 0.0) + 0.5);
                        if (record > 0u) {
                            delta[min(record - 1u, 3u)] += slot.value.x;
                        }
                    }
                }
            }
            // Monod uptake (2026-10-01, see REACTION_MODE in common.glsl), on the substrate after
            // the transport increment and the source; folded into the compensated increment.
            if (REACTION_MODE == 1u && vec4_index == (REACTION_LAYOUT & 15u)) {
                uint substrate_component = (REACTION_LAYOUT >> 4u) & 15u;
                uint biomass_component   = (REACTION_LAYOUT >> 8u) & 15u;
                uint uptake_component    = (REACTION_LAYOUT >> 12u) & 15u;
                float substrate = max(value[min(substrate_component, 3u)] + delta[min(substrate_component, 3u)], 0.0);
                float biomass   = max(value[min(biomass_component, 3u)] + delta[min(biomass_component, 3u)], 0.0);
                float rate_factor = REACTION_Q_MAX * biomass * TIMESTEP / (REACTION_HALF_SATURATION + substrate);
                float uptake = substrate * rate_factor / (1.0 + rate_factor);
                delta[min(substrate_component, 3u)] -= uptake;
                if (uptake_component < 4u) {
                    delta[uptake_component] += uptake;
                }
                if (REACTION_YIELD != 0.0) {
                    delta[min(biomass_component, 3u)] += REACTION_YIELD * uptake;
                }
            }
            // Level-2 cell model (2026-10-06, stage 5, see REACTION_STATE_LAYOUT in common.glsl):
            // uptake limited by the physiological state mu, which relaxes towards the realised growth
            // rate; maintenance and product. The state vec4 has a higher index than this one, so its
            // increment is written back to scalar_delta here and applied by a later pass of this loop.
            // Every expression is finite for any input (RTX 5090 rule, see thin_plates.glsl).
            if (REACTION_MODE == 2u && vec4_index == (REACTION_LAYOUT & 15u)) {
                uint substrate_component   = min((REACTION_LAYOUT >> 4u) & 15u, 3u);
                uint biomass_component     = min((REACTION_LAYOUT >> 8u) & 15u, 3u);
                uint uptake_component      = (REACTION_LAYOUT >> 12u) & 15u;
                uint state_index           = scalar_index(self_particle_id, REACTION_STATE_LAYOUT & 15u);
                uint growth_rate_component = min((REACTION_STATE_LAYOUT >> 4u) & 15u, 3u);
                uint product_component     = (REACTION_STATE_LAYOUT >> 8u) & 15u;
                uint maintenance_component = (REACTION_STATE_LAYOUT >> 12u) & 15u;
                vec4  state_delta = scalar_delta[state_index];
                vec4  state_value = scalar[state_index];
                float substrate   = max(value[substrate_component] + delta[substrate_component], 0.0);
                float biomass     = max(value[biomass_component] + delta[biomass_component], 0.0);
                float growth_rate = max(state_value[growth_rate_component] + state_delta[growth_rate_component], 0.0);
                float biomass_time = biomass * TIMESTEP;
                float rate_factor  = REACTION_Q_MAX * biomass_time / (REACTION_HALF_SATURATION + substrate);
                float uptake       = substrate * rate_factor / (1.0 + rate_factor);              // supply
                float growth_rate_maximum = max(REACTION_YIELD * (REACTION_Q_MAX - REACTION_MAINTENANCE), 0.0);
                if (REACTION_YIELD > 0.0) {
                    float demand = ((growth_rate + REACTION_DEMAND_MARGIN * growth_rate_maximum) / REACTION_YIELD
                                    + REACTION_MAINTENANCE) * biomass_time;
                    uptake = min(uptake, demand);
                }
                float maintenance   = min(uptake, REACTION_MAINTENANCE * biomass_time);
                float growth        = REACTION_YIELD * (uptake - maintenance);
                float growth_actual = growth / max(biomass_time, 1.0e-30);
                float tau           = (growth_actual > growth_rate) ? REACTION_TAU_UP : REACTION_TAU_DOWN;
                float relaxation    = TIMESTEP / max(tau, 1.0e-30);
                float growth_rate_new = (growth_rate + relaxation * growth_actual) / (1.0 + relaxation);
                float product_rate  = max(REACTION_PRODUCT_P0 + growth_rate_new * (REACTION_PRODUCT_P1
                                          + REACTION_PRODUCT_P2 * growth_rate_new), 0.0);
                delta[substrate_component] -= uptake;
                if (uptake_component < 4u) {
                    delta[uptake_component] += uptake;
                }
                delta[biomass_component] += growth;
                state_delta[growth_rate_component] += growth_rate_new - growth_rate;
                if (product_component < 4u) {
                    state_delta[product_component] += product_rate * biomass_time;
                }
                if (maintenance_component < 4u) {
                    state_delta[maintenance_component] += maintenance;
                }
                scalar_delta[state_index] = state_delta;
            }
            // 9-pool cell model (2026-10-07, stage 5, REACTION_MODE 3): Tang et al. 2017 in the form of
            // Haringa et al. 2018 supp. A (tables A1-A3, pool balance eq. 1, algebraic ATP). Parameters and
            // field slots come from ReactionParameterBuffer (common.glsl; order NINEPOOL_PARAMETER_ORDER in
            // utils/sph/case.py). Applied once per particle, in the pass of the substrate's vec4: every vec4
            // is gathered here, the increments of the other vec4 are written back to scalar_delta and picked
            // up by their later passes (case.py checks that they come after the substrate's vec4). Forward
            // Euler as in Haringa 2018; rates per hour, dt_h = dt / 3600. Pools, x_bio and concentrations are
            // read clamped at 0. The glucose uptake is linearised implicitly in C_s (dC_s <= C_s) and the
            // same amount feeds the GLY pool. Every expression is finite for any input (RTX 5090 rule).
            if (REACTION_MODE == 3u && vec4_index == (reaction_field_slot[0] >> 2u)) {
                vec4 np_value[MAX_SCALAR_VEC4];
                vec4 np_delta[MAX_SCALAR_VEC4];
                for (uint v = 0u; v < MAX_SCALAR_VEC4; v++) {
                    np_value[v] = vec4(0.0);
                    np_delta[v] = vec4(0.0);
                }
                for (uint v = 0u; v < SCALAR_VEC4_COUNT; v++) {
                    if (v == vec4_index) {
                        np_value[v] = value;
                        np_delta[v] = delta;
                    } else {
                        uint k = scalar_index(self_particle_id, v);
                        np_value[v] = scalar[k];
                        np_delta[v] = scalar_delta[k];
                    }
                }
#define NP_SLOT(r)  (reaction_field_slot[r])
#define NP_VEC(r)   (min(NP_SLOT(r) >> 2u, MAX_SCALAR_VEC4 - 1u))
#define NP_COMP(r)  (NP_SLOT(r) & 3u)
#define NP_GET(r)   ((NP_SLOT(r) == REACTION_SLOT_NONE) ? 0.0 : max(np_value[NP_VEC(r)][NP_COMP(r)] + np_delta[NP_VEC(r)][NP_COMP(r)], 0.0))
#define NP_ADD(r, x) if (NP_SLOT(r) != REACTION_SLOT_NONE) { np_delta[NP_VEC(r)][NP_COMP(r)] += (x); }
#define NP_P(i)     (reaction_parameter[i])
                float dt_h  = TIMESTEP / 3600.0;
                float Cs    = NP_GET(0);
                float CPAA  = NP_GET(1);
                float xbio  = NP_GET(5);
                float gly   = NP_GET(6);
                float aa    = NP_GET(7);
                float sto   = NP_GET(8);
                float paa   = NP_GET(9);
                float e11   = NP_GET(10);
                float e32   = NP_GET(11);
                float e4    = NP_GET(12);
                float v33   = NP_GET(13);
                float Mw        = NP_P(41);
                float xbio_cmol = xbio / Mw;                                   // Cmol/kg
                float gly2 = gly * gly, gly3 = gly2 * gly;
                float aa2  = aa * aa;
                float sto2 = sto * sto;
                float atp_b3 = NP_P(44) * NP_P(44) * NP_P(44);
                float atp  = NP_P(43) * gly3 / (gly3 + atp_b3);                 // algebraic ATP (Haringa 2018)
                float atp2 = atp * atp, atp3 = atp2 * atp, atp4 = atp2 * atp2;
                // v11: glucose uptake, implicit in C_s
                float a11  = NP_P(4) * e11 * xbio_cmol * dt_h / (Cs + NP_P(5));
                // uptake-inhibition knob (2026-10-08, spec 105, numerical experiment): v11 *= 1 / (1 + X_gly / K_i)
                // with the particle's own X_gly (1) or the population mean the host writes into parameter 46 (2)
                if (NINEPOOL_UPTAKE_INHIBITION != 0u) {
                    float gly_inhibit = (NINEPOOL_UPTAKE_INHIBITION == 2u) ? NP_P(46) : max(gly, 0.0);
                    a11 *= 1.0 / (1.0 + gly_inhibit / NP_P(45));
                }
                float dCs  = Cs * a11 / (1.0 + a11);
                float v11  = dCs / max(xbio_cmol * dt_h, 1.0e-30);             // mol/Cmol/h, consistent with dCs
                float k2;
                k2 = NP_P(7) * NP_P(7);
                float v12 = NP_P(6) * gly2 / (k2 + gly2);
                k2 = NP_P(8) * NP_P(8);
                v12 *= k2 / (k2 + aa2);
                float k3 = NP_P(9) * NP_P(9) * NP_P(9);
                v12 *= atp3 / (k3 + atp3);
                k2 = NP_P(11) * NP_P(11);
                float v13 = NP_P(10) * gly2 / (k2 + gly2);
                k2 = NP_P(12) * NP_P(12);
                v13 *= aa2 / (k2 + aa2);
                k3 = NP_P(13) * NP_P(13) * NP_P(13);
                v13 *= atp3 / (k3 + atp3);                                     // mu, 1/h
                k3 = NP_P(15) * NP_P(15) * NP_P(15);
                float v21 = NP_P(14) * gly3 / (k3 + gly3);
                float k4 = NP_P(16) * NP_P(16) * NP_P(16) * NP_P(16);
                v21 *= k4 / (k4 + atp4);
                float fraction_ext = 1.0 / (1.0 + pow(10.0, NP_P(38) - NP_P(39)));   // undissociated PAA, broth
                float fraction_int = 1.0 / (1.0 + pow(10.0, NP_P(37) - NP_P(39)));   // undissociated PAA, cytosol
                float v31 = NP_P(18) * NP_P(19) * (CPAA * NP_P(42) * fraction_ext - paa / 2.5 * fraction_int);
                float v32 = e32 * paa * Mw * 1.0e-6;
                float cs41 = Cs / (Cs + NP_P(31));
                float cs42 = Cs / (Cs + NP_P(34));
                float v41 = NP_P(30) * e4 * cs41 * (1.0 + 2.0 * cs42) * NP_P(32) / (sto + NP_P(32));
                k2 = NP_P(35) * NP_P(35);
                float v42 = NP_P(33) * e4 * (1.0 - cs42) * (1.0 + 2.0 * cs41) * sto2 / (k2 + sto2);
                k2 = NP_P(36) * NP_P(36);
                v42 *= atp2 / (k2 + atp2);
                float mu    = v13;
                float mu_dt = mu * dt_h;
                float scale = 1.0e6 / Mw * dt_h;                               // mol/Cmol -> umol/gdw per step
                // metabolite pools (table A1 stoichiometry)
                NP_ADD(6, scale * (6.0 * v11 - v12 - 0.578 * v13 - v21 - 4.81 * v33 - 1.07 * v41 + v42) - mu_dt * gly);
                NP_ADD(7, scale * (v12 - 0.5 * v13 - 6.25 * v33) - mu_dt * aa);
                NP_ADD(8, scale * (v41 - v42) - mu_dt * sto);
                NP_ADD(9, scale * (v31 - v32 - v33) - mu_dt * paa);
                // enzyme pools and the penicillin capacity
                float r11  = (mu + NP_P(1)) / NP_P(2);
                float r115 = r11 * r11 * r11 * r11 * r11;
                NP_ADD(10, NP_P(0) * r115 / (1.0 + r115) * dt_h - (mu_dt + NP_P(3) * dt_h) * e11);
                NP_ADD(11, (NP_P(20) + NP_P(21) * mu) * dt_h - (NP_P(22) * dt_h + mu_dt) * e32);
                NP_ADD(12, (NP_P(27) + NP_P(28) * mu) * dt_h - (NP_P(29) * dt_h + mu_dt) * e4);
                float gly_ratio = pow(max(gly / NP_P(25), 1.0e-30), NP_P(26));
                NP_ADD(13, NP_P(23) * mu / (1.0 + gly_ratio) * dt_h - (NP_P(24) * dt_h + mu_dt) * v33);
                // biomass, extracellular fields, records
                NP_ADD(5, (mu - NP_P(40)) * dt_h * xbio);
                NP_ADD(0, -dCs);
                float dCPAA = max((v32 - v31) * xbio_cmol * dt_h, -CPAA);
                NP_ADD(1, dCPAA);
                NP_ADD(2, dCs);
                NP_ADD(3, v33 * xbio_cmol * dt_h);
                if (NP_SLOT(4) != REACTION_SLOT_NONE) {                        // mu of this step, overwritten
                    np_delta[NP_VEC(4)][NP_COMP(4)] = mu - np_value[NP_VEC(4)][NP_COMP(4)];
                }
                for (uint v = 0u; v < SCALAR_VEC4_COUNT; v++) {
                    if (v != vec4_index) {
                        scalar_delta[scalar_index(self_particle_id, v)] = np_delta[v];
                    }
                }
                delta = np_delta[vec4_index];
#undef NP_SLOT
#undef NP_VEC
#undef NP_COMP
#undef NP_GET
#undef NP_ADD
#undef NP_P
            }
            precise vec4 compensation = vec4(0.0);
            if (USE_SCALAR_COMPENSATED_SUM) {
                // Kahan (1965): value holds the running sum, compensation the
                // part of the previous additions lost to rounding. `precise`
                // forbids the compiler to reassociate these four lines, which
                // would cancel the compensation algebraically.
                compensation = scalar_compensation[index];
                precise vec4 corrected = delta - compensation;
                precise vec4 sum = value + corrected;
                compensation = (sum - value) - corrected;
                value = sum;
            } else {
                value = value + delta;
            }
            if (USE_SCALAR_INJECTION) {
                for (uint slot_index = 0u; slot_index < MAX_INJECTION_SLOTS; slot_index++) {
                    ScalarInjectionSlot slot = scalar_injection[slot_index];
                    if (slot.target.x == 0u || slot.target.y != vec4_index || slot.target.w != 0u) continue;
                    vec3 offset = new_position - slot.center_radius_squared.xyz;
                    if (dot(offset, offset) < slot.center_radius_squared.w) {
                        value[slot.target.z] = slot.value.x;
                        compensation[slot.target.z] = 0.0;
                    }
                }
            }
            scalar[index] = value;
            if (USE_SCALAR_COMPENSATED_SUM) {
                scalar_compensation[index] = compensation;
            }
        }
    }

    // ========================================================================
    // Write updated state (only Cases A and B reach here).
    // ========================================================================
    position_voxel_id[self_particle_id] = vec4(new_position, float(new_voxel_id));
    velocity_mass[self_particle_id]     = vec4(new_velocity, self_mass);
}
