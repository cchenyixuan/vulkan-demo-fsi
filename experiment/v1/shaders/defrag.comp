#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "helpers.glsl"

// ============================================================================
// defrag.comp — per-voxel SoA scatter to restore spatial locality.
//
// Over time, particles drift between voxels but their SoA storage slot stays
// fixed → SoA layout becomes incoherent with voxel layout → cache thrashing.
// This kernel rebuilds the SoA so that for every voxel v, that voxel's
// particles occupy a contiguous SoA range [base_v, base_v + count_v).
//
// Per-voxel dispatch: gl_GlobalInvocationID.x → voxel_id (1-based).
//
// Source bindings (set 0): the "current" particle SoA — read-only here.
// Destination bindings (set 4): the "scratch" particle SoA — written here.
// CPU-side bank swap promotes set 4 to be the new set 0 after this dispatch.
//
// Base index strategy (USE_PREFIX_SUM_DEFRAG spec constant):
//   true  → base = voxel_base_offset[voxel_id]   (deterministic voxel-id order;
//                                                 requires prefix_sum.comp first)
//   false → base = atomicAdd(defrag_scratch_counter, count)
//                                                 (non-deterministic per-voxel
//                                                  order, but voxel-internal is
//                                                  still contiguous)
//
// Both paths preserve correctness (total count, voxel-particle assignment).
// Path A additionally guarantees inter-voxel contiguity = stronger cache.
//
// Side effects:
//   - 9 SoA buffers in set 4 written at new positions (every set-0 buffer
//     EXCEPT density_pressure_scratch — see binding 2 note below)
//   - inside_particle_index updated in place to point at new IDs
//   - defrag_scratch_counter incremented (path B only)
//
// ⚠ V0 LIMITATION — INLET particles are dropped by defrag.
// This kernel iterates only inside_particle_index entries. Per the buffer's
// invariant 2 (common.glsl), inlet-kind particles never appear there, so their
// SoA data is NOT copied to the scratch (set 4) destination. After CPU bank
// swap, inlet pool slots in the new set 0 are uninitialised / cleared and the
// inlet particles are effectively gone.
//
// The lid-driven cavity case has no INLET particles so this is dormant in V0.
// V0+ inlet spawn must redesign this path — options include a separate
// "non-voxel particle list" the defrag walks in addition, or rebuilding inlet
// pool slots from inlet_template (set 3 binding 2) after each defrag.
//
// V1.0a: this kernel processes OWN voxels only (filtered by is_own_voxel).
// Ghost voxels are never defragged because:
//   - ghost voxel inside_particle_count + inside_particle_index are written
//     by ghost_send + transport every step (replicas overwrite in place);
//   - ghost-pid range in scratch (set 4) is host-cleared to 0 pre-defrag, so
//     after CPU bank swap the new set 0 ghost-pid range is empty. It gets
//     refilled by next step's ghost_send → transport BEFORE any hot kernel
//     reads it. predict / update_voxel of step N+1 don't touch ghost data.
// Alive packing: own particles defrag-pack into [own_first_pid, own_first_pid +
// alive_count - 1]. Dead slots fill [own_first_pid + alive_count, own_last_pid].
//
// Host orchestration around defrag dispatch (simulator_v1.py):
//   1. vkCmdFillBuffer scratch (set 4) = 0          (zero-init dead region)
//   2. vkCmdFillBuffer defrag_scratch_counter = 0   (reset atomic)
//   3. defrag.comp dispatch (this kernel)
//   4. vkCmdCopyBuffer defrag_scratch_counter → alive_particle_count
//      (refresh post-defrag alive count for downstream install_migrations'
//       overflow check)
//   5. vkCmdFillBuffer migration_install_count = 0
//      (reset end-allocate cycle so install starts at own_last_pid again)
//   6. CPU bank swap: scratch (set 4) becomes new set 0
// ============================================================================

layout(local_size_x_id = 51, local_size_y = 1, local_size_z = 1) in;

// ----------------------------------------------------------------------------
// Destination ("scratch") SoA — set 4 mirrors set 0 layout exactly. This is
// the only set declared locally because it is unique to defrag (other shaders
// never bind 5 sets). All other bindings come from common.glsl.
//
// CPU-side bank swap rebinds the underlying buffer pair after this dispatch
// completes, so set 4 becomes the new set 0 for subsequent step kernels.
// ----------------------------------------------------------------------------

layout(std430, set = 4, binding = 0) writeonly buffer DstPositionVoxelIdBuffer {
    vec4 dst_position_voxel_id[];
};
layout(std430, set = 4, binding = 1) writeonly buffer DstDensityPressureBuffer {
    vec2 dst_density_pressure[];
};
// set 4 binding 2 intentionally unbound: the source buffer there is
// density_pressure_scratch, which is transient (overwritten by density.comp
// every step). Defrag does not need to migrate stale scratch contents, so
// we save ~8 MB of pointless copy each defrag dispatch by leaving this
// slot sparse. The simulator's set-4 layout (sparse {0, 1, 3..9}) reflects
// this — see _build_defrag_set4_layout() in utils/sph/simulator.py.

layout(std430, set = 4, binding = 3) writeonly buffer DstVelocityMassBuffer {
    vec4 dst_velocity_mass[];
};
layout(std430, set = 4, binding = 4) writeonly buffer DstAccelerationBuffer {
    vec4 dst_acceleration[];
};
layout(std430, set = 4, binding = 5) writeonly buffer DstShiftBuffer {
    vec4 dst_shift[];
};
layout(std430, set = 4, binding = 6) writeonly buffer DstMaterialBuffer {
    uint dst_material[];
};
layout(std430, set = 4, binding = 7) writeonly buffer DstCorrectionInverseBuffer {
    vec4 dst_correction_inverse[];
};
layout(std430, set = 4, binding = 8) writeonly buffer DstDensityGradientKernelSumBuffer {
    vec4 dst_density_gradient_kernel_sum[];
};
layout(std430, set = 4, binding = 9) writeonly buffer DstExtensionFieldsBuffer {
    vec4 dst_extension_fields[];
};
// 2026-09-27: persistent particle uid and the scalar buffers (set 0 bindings
// 10-14). Binding 14 (turbulent_viscosity) is recomputed by density.comp before
// force.comp reads it; it is carried only to keep host readbacks aligned.
layout(std430, set = 4, binding = 10) writeonly buffer DstParticleUidBuffer {
    uint dst_particle_uid[];
};
layout(std430, set = 4, binding = 11) writeonly buffer DstScalarBuffer {
    vec4 dst_scalar[];
};
layout(std430, set = 4, binding = 12) writeonly buffer DstScalarCompensationBuffer {
    vec4 dst_scalar_compensation[];
};
layout(std430, set = 4, binding = 13) writeonly buffer DstScalarDeltaBuffer {
    vec4 dst_scalar_delta[];
};
layout(std430, set = 4, binding = 14) writeonly buffer DstTurbulentViscosityBuffer {
    float dst_turbulent_viscosity[];
};

void main() {
    uint voxel_id = gl_GlobalInvocationID.x + 1u;       // 1-based

    // V1.0a: defrag only own voxels. is_own_voxel filter subsumes the
    // padding-thread check (vid > TOTAL_VOXEL_COUNT) AND skips ghost voxels
    // (managed by ghost_send + transport, not by defrag).
    if (!is_own_voxel(voxel_id)) return;

    uint count = inside_particle_count[voxel_id];
    if (count == 0u) return;

    // ------------------------------------------------------------------------
    // Reserve a contiguous range [base, base + count) in the destination SoA.
    // Spec-const branch: glslc -O DCE-removes the unused arm.
    // ------------------------------------------------------------------------
    uint base;
    if (USE_PREFIX_SUM_DEFRAG) {
        base = voxel_base_offset[voxel_id];             // already excludes self;
                                                        // voxel 1's base is 0
    } else {
        base = atomicAdd(defrag_scratch_counter, count);
    }
    // V1.0a: pack alive own particles into the OWN pid sub-range starting at
    // own_first_pid() (= LEADING_GHOST_POOL_SIZE + 1; reduces to 1 for
    // end-of-chain GPUs where LEADING_GHOST_POOL_SIZE = 0, matching V0).
    uint base_id = base + own_first_pid();

    // ------------------------------------------------------------------------
    // Iterate this voxel's slots, copy each particle to its new slot, and
    // patch inside_particle_index in place.
    //
    // Trust invariant 1 of inside_particle_index: valid IDs occupy slots
    // [0, count); empty slots [count, MAX) are 0. We iterate just `count`,
    // not full MAX_PARTICLES_PER_VOXEL, so an early `if (old_id == 0) break`
    // is unnecessary — but kept for defense.
    // ------------------------------------------------------------------------
    for (uint slot = 0u; slot < count; slot++) {
        uint slot_index_global = voxel_id * MAX_PARTICLES_PER_VOXEL + slot;
        uint old_id = inside_particle_index[slot_index_global];
        if (old_id == INSIDE_SLOT_EMPTY) break;          // defensive

        uint new_id = base_id + slot;

        // Copy 9 SoA fields old_id → new_id (skipping density_pressure_scratch,
        // which is transient — see set 4 binding 2 note above).
        dst_position_voxel_id[new_id]            = position_voxel_id[old_id];
        dst_density_pressure[new_id]             = density_pressure[old_id];
        dst_velocity_mass[new_id]                = velocity_mass[old_id];
        dst_acceleration[new_id]                 = acceleration[old_id];
        dst_shift[new_id]                        = shift[old_id];
        dst_material[new_id]                     = material[old_id];
        dst_correction_inverse[new_id * 2u]      = correction_inverse[old_id * 2u];
        dst_correction_inverse[new_id * 2u + 1u] = correction_inverse[old_id * 2u + 1u];
        dst_density_gradient_kernel_sum[new_id]  = density_gradient_kernel_sum[old_id];
        dst_extension_fields[new_id]             = extension_fields[old_id];
        dst_particle_uid[new_id]                 = particle_uid[old_id];
        for (uint vec4_index = 0u; vec4_index < SCALAR_VEC4_COUNT; vec4_index++) {
            dst_scalar[scalar_index(new_id, vec4_index)]              = scalar[scalar_index(old_id, vec4_index)];
            dst_scalar_compensation[scalar_index(new_id, vec4_index)] = scalar_compensation[scalar_index(old_id, vec4_index)];
            dst_scalar_delta[scalar_index(new_id, vec4_index)]        = scalar_delta[scalar_index(old_id, vec4_index)];
        }
        if (USE_SCALAR_SGS) {
            dst_turbulent_viscosity[new_id] = turbulent_viscosity[old_id];
        }

        // Patch the voxel's inside slot to reference the new particle_id.
        inside_particle_index[slot_index_global] = new_id;
    }
}
