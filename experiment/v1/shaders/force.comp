#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "helpers.glsl"
#if WITH_THIN_PLATES
#include "thin_plates.glsl"
#endif

// Scalar transport build switch (2026-09-27). compile_shaders_v1.py builds this
// file twice: force.comp.spv (FORCE_WITH_SCALARS = 0, the scalar code below is
// compiled out and the kernel is identical to the pre-scalar one) and
// force_scalar.comp.spv (-DFORCE_WITH_SCALARS=1). SphSimulatorV1 uses the latter
// only for cases with a `scalars:` block. Inside the scalar build the spec
// constants (SCALAR_VEC4_COUNT, USE_SCALAR_*) still select the variants.
#ifndef FORCE_WITH_SCALARS
#define FORCE_WITH_SCALARS 0
#endif

// ============================================================================
// force.comp - δ-plus WCSPH acceleration + particle shifting (stage 5).
//
// Reads:
//   - Self and neighbor positions, velocities, densities (post-density stage),
//   - Self correction matrix M_i (neighbor M not needed here),
//   - Self kernel_sum for PST blend.
//
// Per-particle accumulators:
//   a_pressure    = -Σ_j V_j · F_ji / ρ_i · ∇W̃_ij       (Tait + TIC)
//   a_viscosity   =  Σ_j 2(DIM+2) · ν · V_j · dot(v_i - v_j, x_ij)
//                        / (r² + ε_h²) · ∇W̃_ij          (Morris)
//   shift_main    = -(CFL · PST_MAIN_SHIFT_COEFFICIENT · 2 · h²) · Σ ... · ∇W̃ · V
//   shift_anti    = +(CFL · PST_MAIN_SHIFT_COEFFICIENT · 2 · h²) · Σ (r/Δx) · ∇W̃ · V · PST_ANTI_SHIFT_COEFFICIENT
//
// Where:
//   F_ji = (P_i > 0) ? P_i + P_j : P_j - P_i                   (TIC)
//   ∇W̃_ij = M_i · ∇W_ij
//
// Outputs:
//   acceleration[pid] = a_pressure + a_viscosity + gravity
//   shift[pid]        = k · shift_main + (1-k) · shift_anti   where k = kernel_sum^4
//   scalar_delta[pid] = dt · (dC/dt)_diffusion + shift · ∇C     (FLUID, scalars on)
//
// Scalar transport (2026-09-27), FLUID self and FLUID neighbours only
// (solids carry no scalar; excluding them makes the walls zero-flux):
//   (dC/dt)_i = Σ_j  2 m_j (D_i + D_j) / (ρ_i + ρ_j)
//                    · λ_ij (C_i - C_j) (x_ij · ∇W_ij) / (r² + η²)
//   λ_ij = (d / tr M_i + d / tr M_j) / 2,   tr M = Σ_j V_j (x_j - x_i)·∇W_ij
//     Brookshaw / Morris form of (1/ρ) ∇·(ρ D ∇C) with the arithmetic pair
//     mean of D (as in Morris et al. 1997 for the viscosity; the harmonic
//     mean of Cleary & Monaghan 1999 is only needed at jumps of D, and solids
//     are excluded explicitly here) and the pair volume 2 m_j / (ρ_i + ρ_j),
//     raw ∇W, plus two corrections
//     (d / tr M and the FLUID flag are precomputed by correction.comp):
//     * λ_ij renormalises the operator. On a lattice with isotropic M
//       (M = (tr M / d) I) it makes the Laplacian exact for every quadratic
//       field (trace identity -Σ_j V_j x_ij·M⁻¹∇W_ij = d). Without it the raw
//       operator over-diffuses by 15.3 % on the h/dx = 3 simple cubic lattice
//       with the calibrated particle volume; using the stored KCG inverse
//       instead would under-diffuse by 7.6 %, because correction.comp inverts
//       M + ξ I with ξ = 0.1 against tr M / 3 ≈ 1.21 (both measured and
//       computed 2026-09-27, log/2026-09-27_scalar-transport.md). tr M is the
//       unregularized trace that correction.comp stores for this purpose.
//     * η² = 0.01 dx² instead of EPS_H_SQUARED = 0.01 h² (h = support radius =
//       3 dx): the latter removes 8 % of each nearest-neighbour term and ~5 %
//       of the Laplacian; η only has to keep coincident particles finite.
//     The pair factor 2 m_i m_j (D_i + D_j) / (ρ_i + ρ_j), λ_ij and
//     x_ij·∇W_ij are all symmetric in (i, j), so the pair contributions to
//     Σ_i m_i C_i cancel exactly: every scalar is conserved to round-off. For
//     D_i = D_j and λ = 1 it reduces to Σ_j V_j 2D (C_i - C_j) x_ij·∇W_ij / r²,
//     the standard SPH Laplacian (x_ij·∇W_ij < 0, so a local maximum decays).
//     D = D_m + w · ν_t / Sc_t per field (D_m, w from ScalarParametersBuffer,
//     ν_t from density.comp this step when USE_SCALAR_SGS).
//   ∇C_i = Σ_j V_j (C_j - C_i) M_i⁻¹ ∇W_ij   with the stored KCG inverse
//     (first-order consistent to 0.8 % with ξ = 0.01, see density.comp).
//   Bounds limiter (USE_SCALAR_BOUNDS_LIMITER, only together with the shift
//     correction): ΔC_i is clipped so that C_i + ΔC_i stays in [min, max] of C
//     over self and FLUID neighbours. The diffusion alone is monotone and needs
//     no limiter; the shift correction is an unlimited Taylor interpolation.
//     used only for the shift correction C += shift · ∇C (the δ-plus shift
//     moves the particle away from its material path; interpolating the
//     field to the new position keeps the shift from transporting scalar).
//
// V0 simplification: particles share globally uniform viscosity / radius /
// mass / volume. All pair-averaged quantities (ν_ij, Δx, V_ij, volume_ij)
// reduce to self's values, so the neighbor loop does NOT read neighbor
// MaterialParameters. When multi-phase is enabled (V0+), add back the per-
// neighbor material / material_parameters reads and restore the harmonic means.
//
// Boundary particles early-return (static). Rotor computes the full
// kernel but predict overrides its motion. Micropolar / curl output omitted.
//
// V1 merged-buffer scheme: own + ghost share set 0 / set 1. Self dispatch
// is bounded to the own pid range. Neighbor iteration uses in_own_grid
// (extended) so ghost neighbors are visible automatically.
//
// V1 freshness summary at force.comp time (Option B single sync):
//   self own (after correction.comp + density.comp this step):
//     position = t, velocity = t, ρ/P = t (fresh from density.comp's
//                  scratch+copy), correction_inverse = t, kernel_sum = t.
//   neighbor own:  position = t, velocity = t, ρ/P = t (same).
//   neighbor GHOST: position = t, velocity = t, but
//                   **ρ/P = t-1** (peer's last density.comp; sync 1 was
//                   before peer's density this step).
//
// The ρ/P mismatch flows live into a_pressure (via neighbor_pressure +
// neighbor_volume_dynamic = self_mass/neighbor_density), a_viscosity (via
// neighbor_volume_dynamic), and the PST disorder term. Affects only own
// particles in the boundary band (those whose neighbour iteration reaches
// ghost voxels). ~1e-4 relative bias at low Mach. Fixed by sync 2 between
// density.comp and force.comp (Option D, V1.0a/V1.1).
// ============================================================================

// ============================================================================
// Reaction force on a solid particle (2026-09-29, USE_SOLID_REACTION_FORCE).
// For every FLUID neighbour i of the solid particle j the acceleration that i
// receives from j is evaluated exactly as in the fluid particle's own loop
// (its matrix M_i, its density and pressure, its TIC switch, the solid
// pressure of SOLID_PRESSURE_MODE), and j receives the opposite momentum:
//     a_j = - sum_i (m_i / m_j) a_(i <- j).
// Solid neighbours are skipped.
// ============================================================================
vec3 solid_reaction_acceleration(uint self_particle_id, uint self_kind, vec3 self_position,
                                 ivec3 self_voxel_coord, vec3 self_velocity, float self_mass,
                                 float self_density, float self_pressure) {
    vec3 reaction = vec3(0.0);
    vec3 gravity_vector = vec3(GRAVITY_X, GRAVITY_Y, GRAVITY_Z);
    vec3 relative_body_force = gravity_vector - solid_particle_acceleration(self_kind, self_position);
    float morris_coefficient = 2.0 * (float(DIMENSION) + 2.0);
    uint cell_count = USE_NEIGHBOR_LIST ? 1u : (NEIGHBOR_Z_RANGE == 0u ? 9u : 27u);
    for (uint cell = 0u; cell < cell_count; cell++) {
        uint candidate_count;
        uint candidate_base = 0u;
        if (USE_NEIGHBOR_LIST) {
            candidate_count = neighbor_count[self_particle_id];
        } else {
            ivec3 delta = ivec3(int(cell % 3u) - 1,
                                int((cell / 3u) % 3u) - 1,
                                int(cell / 9u) - int(NEIGHBOR_Z_RANGE));
            ivec3 neighbor_coord = self_voxel_coord + delta;
            if (!in_own_grid(neighbor_coord)) continue;
            uint neighbor_voxel_id = own_voxel_id_of(neighbor_coord);
            candidate_count = inside_particle_count[neighbor_voxel_id];
            candidate_base  = neighbor_voxel_id * MAX_PARTICLES_PER_VOXEL;
        }
        for (uint candidate = 0u; candidate < candidate_count; candidate++) {
            uint fluid_particle_id;
            if (USE_NEIGHBOR_LIST) {
                fluid_particle_id = neighbor_list[candidate * neighbor_list_stride() + self_particle_id];
            } else {
                fluid_particle_id = inside_particle_index[candidate_base + candidate];
                if (fluid_particle_id == INSIDE_SLOT_EMPTY) break;
                if (fluid_particle_id == self_particle_id) continue;
            }
            MaterialParameters fluid_params = material_parameters[material[fluid_particle_id]];
            if (fluid_params.kind != MATERIAL_FLUID) continue;

            vec3 fluid_position = position_voxel_id[fluid_particle_id].xyz;
            vec3 position_difference_solid_to_fluid = fluid_position - self_position;      // x_ij, i = fluid
            float distance_squared = dot(position_difference_solid_to_fluid, position_difference_solid_to_fluid);
            if (distance_squared >= smoothing_length_squared() || distance_squared < 1e-24) continue;
            float distance = sqrt(distance_squared);
#if WITH_THIN_PLATES
            // the fluid behind a plate does not reach this solid particle
            if (near_thin_plate_count > 0u
                    && thin_plate_blocking_slot(self_position, fluid_position) != MAX_NEAR_THIN_PLATES) continue;
#endif

            vec4  fluid_velocity_mass = velocity_mass[fluid_particle_id];
            vec2  fluid_density_pressure = density_pressure[fluid_particle_id];
            float fluid_density  = fluid_density_pressure.x;
            float fluid_pressure = fluid_density_pressure.y;
            mat3  fluid_correction_matrix = USE_KCG_CORRECTION
                ? unpack_correction_inverse(fluid_particle_id)
                : mat3(1.0);
            bool  fluid_near_surface = density_gradient_kernel_sum[fluid_particle_id].w < 0.75;

            // the solid particle as the fluid particle sees it
            float solid_volume_dynamic = fluid_velocity_mass.w / self_density;
            float solid_pressure = self_pressure;
            if (solid_pressure_is_mirrored()) {
                solid_pressure = fluid_pressure + SOLID_PRESSURE_OFFSET
                    + fluid_density * dot(relative_body_force, -position_difference_solid_to_fluid);
            }
            bool symmetric_form = (fluid_pressure > 0.0 || fluid_near_surface) || (SOLID_PRESSURE_MODE == 1u);
            float pressure_combined = symmetric_form
                ? (solid_pressure + fluid_pressure)
                : (solid_pressure - fluid_pressure);

            vec3 kernel_gradient_corrected = fluid_correction_matrix
                * evaluate_kernel_gradient_unguarded(position_difference_solid_to_fluid, distance);
            vec3 fluid_acceleration_from_solid =
                -solid_volume_dynamic * pressure_combined / fluid_density * kernel_gradient_corrected
                + morris_coefficient * fluid_params.viscosity * solid_volume_dynamic
                  * dot(fluid_velocity_mass.xyz - self_velocity, position_difference_solid_to_fluid)
                  / (distance_squared + EPS_H_SQUARED)
                  * kernel_gradient_corrected;
            reaction -= (fluid_velocity_mass.w / self_mass) * fluid_acceleration_from_solid;
        }
    }
    return reaction + gravity_vector;
}

layout(local_size_x_id = 51, local_size_y = 1, local_size_z = 1) in;

void main() {
    // 0-based → 1-based particle_id
    uint self_particle_id = gl_GlobalInvocationID.x + own_first_pid();
    if (self_particle_id > own_last_pid()) return;
#if WITH_THIN_PLATES
    // reaction record of this slot: empty unless the loop below meets a wall dummy
    thin_plate_reaction[2u * self_particle_id]      = vec4(0.0);
    thin_plate_reaction[2u * self_particle_id + 1u] = vec4(0.0);
#endif

    // --- Self material group --------------------------------------------------
    uint self_group_id = material[self_particle_id];
    MaterialParameters self_params = material_parameters[self_group_id];

    // Boundary particles are static by definition — no force-driven motion and
    // no PST applies. They still participate in density.comp so fluid particles
    // can read their pressure, but their own acceleration / shift are never used.
    // 2026-09-29: with USE_SOLID_REACTION_FORCE they receive the reaction of the
    // fluid (diagnostic only: predict.comp never moves a BOUNDARY particle).
    if (self_params.kind == MATERIAL_BOUNDARY && !USE_SOLID_REACTION_FORCE) return;
    // Inlet particles are emitter templates with no valid SPH state.
    if (self_params.kind == MATERIAL_INLET)    return;

    // --- Self position + voxel_id --------------------------------------------
    vec4 self_position_voxel_id = position_voxel_id[self_particle_id];
    vec3 self_position          = self_position_voxel_id.xyz;
    uint self_voxel_id          = uint(round(self_position_voxel_id.w));
    if (self_voxel_id == VOXEL_ID_DEAD) return;

    // --- Self velocity + mass + density + pressure ---------------------------
    // density_pressure: canonical ρ_{n+1}, P_{n+1} for OWN particles.
    // density.comp wrote to scratch; the simulator already issued
    // vkCmdCopyBuffer scratch → primary inside the same step cmd, so OWN
    // slots in this binding hold step-t fresh ρ_{n+1}, P_{n+1}.
    //
    // Caveat: GHOST slots still hold the values that ghost_send packed at
    // sync 1 time (= peer's step-t-1 density.comp output). force.comp's
    // ghost-neighbor reads of density_pressure are therefore one density
    // step stale until Option D sync 2 is added.
    vec4  self_velocity_mass = velocity_mass[self_particle_id];
    vec3  self_velocity      = self_velocity_mass.xyz;
    float self_mass          = self_velocity_mass.w;

    vec2  self_density_pressure = density_pressure[self_particle_id];
    float self_density  = self_density_pressure.x;
    float self_pressure = self_density_pressure.y;

    // --- Self correction matrix (KCG) and kernel_sum --------------------------
    // KCG ablation: USE_KCG_CORRECTION=false → identity M⁻¹ (spec-const DCE'd).
    // kernel_sum is ALWAYS read because PST main/anti blend uses it regardless.
    mat3 self_correction_matrix = USE_KCG_CORRECTION
        ? unpack_correction_inverse(self_particle_id)
        : mat3(1.0);
    float self_kernel_sum = density_gradient_kernel_sum[self_particle_id].w;
    // Free-surface heuristic. In δ-plus WCSPH, fully-supported (interior)
    // particles have kernel_sum ≈ 1; values below ~0.75 indicate the
    // neighborhood is kernel-deficient (near a free surface). 0.75 is empirical.
    // Equivalent to the legacy form (kernel_sum * 4 - 3 < 0).
    bool near_surface = self_kernel_sum < 0.75;

    // --- Decode self voxel coord ---------------------------------------------
    ivec3 self_voxel_coord = own_coord_of(self_voxel_id);

#if WITH_THIN_PLATES
    // --- Thin plates (2026-09-30) ---------------------------------------------
    gather_near_thin_plates(self_position);
    if (is_thin_plate_particle(self_pressure)) {
        // plate particle: no load of its own, the load on the plates is the
        // reaction stored with the fluid particles (ThinPlateReactionBuffer)
        acceleration[self_particle_id] = vec4(GRAVITY_X, GRAVITY_Y, GRAVITY_Z, 0.0);
        shift[self_particle_id]        = vec4(0.0);
        return;
    }
    // Pressure gradient of the fluid on the side of this particle: next to a
    // plate correction.comp stores the density gradient of the neighbours that
    // are not behind a plate, such that B_i times the stored vector is that
    // (one-sided, renormalised) gradient.
    vec3 thin_plate_force         = vec3(0.0);   // m_i a_i from the wall dummies
    uint thin_plate_first         = 0u;          // index + 1 of the plate of the first dummy
    vec3 self_pressure_gradient   = vec3(0.0);
    if (near_thin_plate_count > 0u) {
        float sound_speed_squared = SPEED_OF_SOUND * SPEED_OF_SOUND
            * pow(self_density / self_params.rest_density, POWER_PARAMETER - 1.0);
        mat3 gradient_matrix = USE_KCG_CORRECTION ? unpack_correction_inverse(self_particle_id) : mat3(1.0);
        self_pressure_gradient = sound_speed_squared
            * (gradient_matrix * density_gradient_kernel_sum[self_particle_id].xyz);
    }
#endif

    // --- Solid particle: reaction of the fluid (2026-09-29) --------------------
    if (USE_SOLID_REACTION_FORCE && is_solid_kind(self_params.kind)) {
        vec3 reaction_acceleration = solid_reaction_acceleration(
            self_particle_id, self_params.kind, self_position, self_voxel_coord,
            self_velocity, self_mass, self_density, self_pressure);
        acceleration[self_particle_id] = vec4(reaction_acceleration, 0.0);
        shift[self_particle_id]        = vec4(0.0);
        return;
    }

#if FORCE_WITH_SCALARS
    // --- Scalar transport: self state (2026-09-27) ---------------------------
    // Only FLUID particles carry scalars. The register arrays have
    // MAX_SCALAR_VEC4 entries; every loop below runs to SCALAR_VEC4_COUNT, a
    // spec constant, so the driver unrolls them and drops unused entries.
    bool do_scalar = (SCALAR_VEC4_COUNT > 0u) && (self_params.kind == MATERIAL_FLUID);
    bool do_scalar_gradient = do_scalar && USE_PST && USE_SCALAR_SHIFT_CORRECTION;
    float self_turbulent_viscosity = 0.0;
    if (USE_SCALAR_SGS && do_scalar) {
        self_turbulent_viscosity = turbulent_viscosity[self_particle_id];
    }
    // η² of the scalar Laplacian = 0.01 dx², and the self half of λ_ij
    // (see the header). Guarded for a particle without neighbours.
    float scalar_laplacian_eps_squared = 0.04 * self_params.radius * self_params.radius;
    float self_inverse_trace = do_scalar
        ? scalar_normalisation_and_fluid_flag(self_particle_id).x : 1.0;   // d / tr M_i
    // KCG inverse for ∇C (shift correction only).
    mat3 scalar_gradient_matrix = mat3(1.0);
    if (do_scalar_gradient && USE_KCG_CORRECTION) {
        scalar_gradient_matrix = self_correction_matrix;
    }
    vec4 self_scalar[MAX_SCALAR_VEC4];
    vec4 self_diffusivity[MAX_SCALAR_VEC4];
    vec4 scalar_rate[MAX_SCALAR_VEC4];          // (dC/dt)_diffusion
    vec4 scalar_gradient_x[MAX_SCALAR_VEC4];    // ∇C, one vec4 per axis
    vec4 scalar_gradient_y[MAX_SCALAR_VEC4];
    vec4 scalar_gradient_z[MAX_SCALAR_VEC4];
    vec4 scalar_minimum[MAX_SCALAR_VEC4];       // bounds limiter: range of C over
    vec4 scalar_maximum[MAX_SCALAR_VEC4];       // self + FLUID neighbours
    for (uint vec4_index = 0u; vec4_index < SCALAR_VEC4_COUNT; vec4_index++) {
        self_scalar[vec4_index]       = do_scalar
            ? scalar[scalar_index(self_particle_id, vec4_index)] * scalar_component_mask(vec4_index)
            : vec4(0.0);
        self_diffusivity[vec4_index]  = scalar_parameters[2u * vec4_index]
                             + scalar_parameters[2u * vec4_index + 1u]
                               * (self_turbulent_viscosity * INVERSE_TURBULENT_SCHMIDT);
        scalar_rate[vec4_index]       = vec4(0.0);
        scalar_gradient_x[vec4_index] = vec4(0.0);
        scalar_gradient_y[vec4_index] = vec4(0.0);
        scalar_gradient_z[vec4_index] = vec4(0.0);
        scalar_minimum[vec4_index] = self_scalar[vec4_index];
        scalar_maximum[vec4_index] = self_scalar[vec4_index];
    }

#endif

    // --- Accumulators --------------------------------------------------------
    vec3 a_pressure          = vec3(0.0);
    vec3 a_viscosity         = vec3(0.0);
    vec3 particle_shift_main = vec3(0.0);
    vec3 particle_shift_anti = vec3(0.0);
    // ω_z = [∇ × v]_z — 2D scalar vorticity, diagnostic-only (render color
    // mode 5). Accumulated with the SAME M-corrected gradient the physics uses,
    // so it is first-order consistent and recovers the true curl in physical
    // units (1/s). Positive = counter-clockwise. Stashed in acceleration.w
    // (line ~271), a slot the pipeline otherwise leaves at 0.
    float vorticity_z = 0.0;
    // PST_NEAR_SOLID_MODE: sum of V_j grad W_ij over the solid neighbours, the
    // direction of the local solid normal.
    vec3 solid_kernel_gradient_sum = vec3(0.0);

    // ========================================================================
    // Loop-invariant constants (all pair-averaged quantities uniform in V0).
    //
    // When multi-phase is enabled, move these inside the loop and compute
    // per-pair harmonic means from neighbor_params:
    //   ν_ij  = 2 · ν_i · ν_j  / (ν_i + ν_j + ε)
    //   Δx_ij = R_i + R_j
    //   V_ij  = 2 · V_i · V_j  / (V_i + V_j)
    //   W_Δx  = evaluate_kernel(Δx_ij)     (per-pair)
    // ========================================================================
    float morris_coefficient  = 2.0 * (float(DIMENSION) + 2.0);  // 8 (2D), 10 (3D)
    float pst_base_factor     = CFL_NUMBER * PST_MAIN_SHIFT_COEFFICIENT * 2.0 * (SMOOTHING_LENGTH * SMOOTHING_LENGTH);

    // V0-uniform pair quantities
    float viscosity_uniform       = self_params.viscosity;
    float delta_x_uniform         = 2.0 * self_params.radius;
    float volume_ij_uniform       = self_params.volume;
    float kernel_value_at_delta_x = evaluate_kernel(delta_x_uniform);  // computed once

    // ------------------------------------------------------------------------
    // Neighbour loop (2026-09-25). Two candidate sources, chosen at pipeline
    // creation by USE_NEIGHBOR_LIST (the other branch is dead code):
    //   list mode : one "cell" = this particle's row of the per-step
    //               neighbour list (build_neighbor_list.comp); every entry
    //               already passed the support test, nothing is filtered here.
    //   voxel mode: 27 cells (9 in 2D) = the surrounding voxels, walked
    //               z-slowest / x-fastest exactly like the original triple
    //               loop; the support test is applied per candidate.
    // Both modes visit the same pairs in the same order, so their sums agree
    // to floating-point rounding.
    // ------------------------------------------------------------------------
    uint cell_count = USE_NEIGHBOR_LIST ? 1u : (NEIGHBOR_Z_RANGE == 0u ? 9u : 27u);
    for (uint cell = 0u; cell < cell_count; cell++) {
        uint candidate_count;
        uint candidate_base = 0u;   // voxel mode: flat index of the voxel's slot 0
        if (USE_NEIGHBOR_LIST) {
            candidate_count = neighbor_count[self_particle_id];
        } else {
            ivec3 delta = ivec3(int(cell % 3u) - 1,
                                int((cell / 3u) % 3u) - 1,
                                int(cell / 9u) - int(NEIGHBOR_Z_RANGE));
            ivec3 neighbor_coord = self_voxel_coord + delta;
            if (!in_own_grid(neighbor_coord)) continue;
            uint neighbor_voxel_id = own_voxel_id_of(neighbor_coord);
            candidate_count = inside_particle_count[neighbor_voxel_id];
            candidate_base  = neighbor_voxel_id * MAX_PARTICLES_PER_VOXEL;
        }

        for (uint candidate = 0u; candidate < candidate_count; candidate++) {
            uint neighbor_particle_id;
            if (USE_NEIGHBOR_LIST) {
                neighbor_particle_id = neighbor_list[candidate * neighbor_list_stride() + self_particle_id];
            } else {
                neighbor_particle_id = inside_particle_index[candidate_base + candidate];
                if (neighbor_particle_id == INSIDE_SLOT_EMPTY) break;
                if (neighbor_particle_id == self_particle_id) continue;
            }

            // --- Distance check (Wendland C4 support radius = h) ----
            vec3 neighbor_position = position_voxel_id[neighbor_particle_id].xyz;
            vec3 position_difference_neighbor_to_self = self_position - neighbor_position; // x_ij = r_i - r_j
            // Squared test first (2026-09-25): the sqrt is only paid for
            // the ~15 % of candidates inside the support, not for all 27
            // voxels' worth. Same accept set as `length(x) >= h` up to
            // rounding at q = 1 where W and grad W are exactly 0 anyway.
            float distance_squared = dot(position_difference_neighbor_to_self, position_difference_neighbor_to_self);
            if (!USE_NEIGHBOR_LIST) {
                if (distance_squared >= smoothing_length_squared() || distance_squared < 1e-24) continue;
            }
            float distance = sqrt(distance_squared);

            // --- Neighbor dynamic state (no material lookup in V0) --
            // V0 uniformity: self_mass used for neighbor mass; ν / R / V
            // also taken from self_params outside the loop.
            vec3  neighbor_velocity = velocity_mass[neighbor_particle_id].xyz;
            vec2  neighbor_density_pressure = density_pressure[neighbor_particle_id];
            float neighbor_density  = neighbor_density_pressure.x;
            float neighbor_pressure = neighbor_density_pressure.y;
            float neighbor_volume_dynamic = self_mass / neighbor_density;
#if WITH_THIN_PLATES
            // A neighbour behind a plate (a plate particle, or any particle whose
            // segment to this one crosses the plate) is a dummy particle of the wall:
            // velocity of the plate, pressure mirrored from this particle. It still
            // counts as it is for the particle shift.
            bool neighbor_is_wall_dummy = false;
            uint wall_slot = MAX_NEAR_THIN_PLATES;
            if (near_thin_plate_count > 0u) {
                wall_slot = thin_plate_wall_slot(self_position, neighbor_position, neighbor_pressure);
                if (wall_slot != MAX_NEAR_THIN_PLATES) {
                    neighbor_is_wall_dummy = true;
                    neighbor_velocity = thin_plate_velocity(wall_slot, neighbor_position);
                    neighbor_pressure = thin_plate_mirror_pressure(
                        wall_slot, self_pressure, self_density, self_position, self_velocity,
                        near_thin_plate[thin_plate_safe_slot(wall_slot)].self_distance,
                        near_thin_plate[thin_plate_safe_slot(wall_slot)].self_over_plate, neighbor_position,
                        self_pressure_gradient);
                } else if (is_thin_plate_particle(neighbor_pressure)) {
                    continue;
                }
            }
#endif

            // --- Kernel gradient (raw + M_i-corrected) + kernel value ---
            vec3  kernel_gradient_raw       = evaluate_kernel_gradient_unguarded(position_difference_neighbor_to_self, distance);
            vec3  kernel_gradient_corrected = self_correction_matrix * kernel_gradient_raw;
            float kernel_value              = evaluate_kernel_unguarded(distance);

            // Pair correction (2026-09-30, PAIR_CORRECTION_MODE 1 / 2): FLUID-FLUID
            // pairs use both correction matrices in the pressure and viscous
            // forces, see common.glsl. The FLUID flag of the neighbour is stored
            // next to its matrix (correction_inverse[2 j + 1].w).
            vec3  kernel_gradient_pair     = kernel_gradient_corrected;   // 1/2 (B_i + B_j) grad W
            vec3  kernel_gradient_neighbor = kernel_gradient_corrected;   // B_j grad W
            float pair_volume_viscous      = neighbor_volume_dynamic;
            bool  pair_is_corrected        = false;
#if WITH_THIN_PLATES
            if (PAIR_CORRECTION_MODE != 0u && USE_KCG_CORRECTION && self_params.kind == MATERIAL_FLUID
                    && !neighbor_is_wall_dummy) {
#else
            if (PAIR_CORRECTION_MODE != 0u && USE_KCG_CORRECTION && self_params.kind == MATERIAL_FLUID) {
#endif
                vec4 neighbor_matrix_a = correction_inverse[neighbor_particle_id * 2u];
                vec4 neighbor_matrix_b = correction_inverse[neighbor_particle_id * 2u + 1u];
                if (neighbor_matrix_b.w > 0.5) {
                    mat3 neighbor_correction_matrix = mat3(
                        vec3(neighbor_matrix_a.x, neighbor_matrix_a.w, neighbor_matrix_b.x),
                        vec3(neighbor_matrix_a.w, neighbor_matrix_a.y, neighbor_matrix_b.y),
                        vec3(neighbor_matrix_b.x, neighbor_matrix_b.y, neighbor_matrix_a.z));
                    kernel_gradient_neighbor = neighbor_correction_matrix * kernel_gradient_raw;
                    kernel_gradient_pair = 0.5 * (kernel_gradient_corrected + kernel_gradient_neighbor);
                    pair_volume_viscous = 2.0 * self_mass / (self_density + neighbor_density);
                    pair_is_corrected = true;
                }
            }

            // ==== Pressure force (TIC) ==============================
            // Symmetric (P_i + P_j) form when self is compressive (P_i > 0);
            // anti-symmetric (P_j - P_i) otherwise to suppress tensile
            // instability in the interior.
            // Mirrored solid pressure (2026-09-29, SOLID_PRESSURE_MODE 1 / 2):
            // for a solid neighbour the stored pressure is replaced by the
            // fluid particle's own pressure continued to the solid particle.
            bool symmetric_form = (self_pressure > 0.0 || near_surface);
            if (PST_NEAR_SOLID_MODE != 0u) {
                uint neighbor_kind = material_parameters[material[neighbor_particle_id]].kind;
                if (is_solid_kind(neighbor_kind)) {
                    solid_kernel_gradient_sum += neighbor_volume_dynamic * kernel_gradient_raw;
                }
            }
            if (solid_pressure_is_mirrored()) {
                uint neighbor_kind = material_parameters[material[neighbor_particle_id]].kind;
                if (is_solid_kind(neighbor_kind)) {
                    vec3 relative_body_force = vec3(GRAVITY_X, GRAVITY_Y, GRAVITY_Z)
                        - solid_particle_acceleration(neighbor_kind, neighbor_position);
                    neighbor_pressure = self_pressure + SOLID_PRESSURE_OFFSET
                        + self_density * dot(relative_body_force, -position_difference_neighbor_to_self);
                    symmetric_form = symmetric_form || (SOLID_PRESSURE_MODE == 1u);
                }
            }
            float pressure_combined = symmetric_form
                    ? (neighbor_pressure + self_pressure)
                    : (neighbor_pressure - self_pressure);
            vec3 pressure_gradient_pair = pressure_combined * kernel_gradient_pair;
            if (PAIR_CORRECTION_MODE == 2u && pair_is_corrected) {
                // reverse correction: P_i B_j + P_j B_i; the TIC form keeps B_i
                pressure_gradient_pair = symmetric_form
                    ? (self_pressure * kernel_gradient_neighbor + neighbor_pressure * kernel_gradient_corrected)
                    : (pressure_combined * kernel_gradient_corrected);
            }
            a_pressure -= neighbor_volume_dynamic / self_density * pressure_gradient_pair;

            // ==== Viscosity (Morris) ================================
#if WITH_THIN_PLATES
            if (neighbor_is_wall_dummy) {
                // the force this particle receives from the plate
                vec3 plate_pair_acceleration = -neighbor_volume_dynamic / self_density * pressure_gradient_pair;
                if (USE_THIN_PLATE_VISCOSITY) {
                    plate_pair_acceleration +=
                        morris_coefficient * viscosity_uniform * pair_volume_viscous
                        * dot(self_velocity - neighbor_velocity,
                              position_difference_neighbor_to_self)
                        / (distance * distance + EPS_H_SQUARED)
                        * kernel_gradient_pair;
                }
                thin_plate_force += self_mass * plate_pair_acceleration;
                if (thin_plate_first == 0u) {
                    thin_plate_first = near_thin_plate[thin_plate_safe_slot(wall_slot)].index + 1u;
                }
            }
            if (!neighbor_is_wall_dummy || USE_THIN_PLATE_VISCOSITY)
#endif
            a_viscosity +=
                morris_coefficient * viscosity_uniform * pair_volume_viscous
                * dot(self_velocity - neighbor_velocity,
                      position_difference_neighbor_to_self)
                / (distance * distance + EPS_H_SQUARED)
                * kernel_gradient_pair;

            // ==== Vorticity (ω_z = [∇×v]_z) — diagnostic for viz =====
            // (∇×v)_i ≈ Σ_j V_j (v_i - v_j) × ∇W̃_ij ; z-component in 2D.
            // The (v_i - v_j) ordering (not v_j - v_i) makes the sign
            // physical: with the M-corrected gradient this reduces to
            // +2Ω for a solid-body rotation Ω (positive = CCW).
            vec3 velocity_difference_self_minus_neighbor =
                self_velocity - neighbor_velocity;
            vorticity_z += neighbor_volume_dynamic
                * (velocity_difference_self_minus_neighbor.x * kernel_gradient_corrected.y
                 - velocity_difference_self_minus_neighbor.y * kernel_gradient_corrected.x);

            // ==== Particle shifting (PST) ===========================
            // Gated by USE_PST spec const: glslc -O DCE-removes the entire
            // block (including the kernel_value / kernel_value_at_delta_x
            // computations and pst_base_factor / volume_ij_uniform pre-loop
            // constants once their consumers are gone) when USE_PST = false.
            if (USE_PST) {
                // disorder ∈ [-1, 0]: negative if particles overlap (r < Δx).
                float distance_ratio = (distance - delta_x_uniform) / delta_x_uniform;
                float disorder =
                    (distance_ratio > 0.0)
                        ? 0.0
                        : distance_ratio * min(neighbor_density / self_density, 1.0);

                // Crowding term: W(r) / W(Δx), raised to 4th power.
                // kernel_value_at_delta_x is a loop invariant (computed above).
                float crowding_ratio =
                    (kernel_value_at_delta_x > 1e-12)
                        ? kernel_value / kernel_value_at_delta_x
                        : 0.0;
                float crowding_term = crowding_ratio * crowding_ratio;
                crowding_term *= crowding_term;  // (W/W_ref)^4

                // Main (repulsion + structure) shift.
                // The 0.1 and 0.2 weights mix kernel_sum (free-surface signal)
                // and crowding (local packing density) into the shift driver.
                // Both are δ-plus empirical constants — kept at legacy values
                // pending profile-driven retuning.
                float main_scalar =
                    1.0 - disorder + 0.1 * self_kernel_sum + 0.2 * crowding_term;
                particle_shift_main +=
                    -pst_base_factor * main_scalar * kernel_gradient_corrected * volume_ij_uniform;

                // Anti (cohesion-like) shift.
                float anti_scalar = (distance / delta_x_uniform) * PST_ANTI_SHIFT_COEFFICIENT;
                particle_shift_anti +=
                    pst_base_factor * anti_scalar * kernel_gradient_corrected * volume_ij_uniform;
            }

#if FORCE_WITH_SCALARS
            // ==== Scalar transport (2026-09-27) ======================
            // FLUID self; FLUID neighbours contribute, solid ones do not (see the
            // header for the formulas). Branch-free over the neighbour kind: all
            // loads are issued unconditionally so that the scalar loads overlap
            // with the flag load (a dependent branch serialised them and cost
            // ~25 % of force's time), and a solid neighbour, whose scalar is 0
            // and flag 0, is removed by fluid_weight.
            if (do_scalar) {
                vec2  neighbor_normalisation_and_flag = scalar_normalisation_and_fluid_flag(neighbor_particle_id);
                float fluid_weight  = neighbor_normalisation_and_flag.y;          // 1 FLUID, 0 solid
#if WITH_THIN_PLATES
                if (neighbor_is_wall_dummy) fluid_weight = 0.0;                    // no flux through a plate
#endif
                float neighbor_mass = velocity_mass[neighbor_particle_id].w;
                float neighbor_turbulent_viscosity =
                    USE_SCALAR_SGS ? turbulent_viscosity[neighbor_particle_id] : 0.0;
                // One division per pair:
                //   2 m_j / (ρ_i + ρ_j) · λ_ij · x_ij·∇W_ij / (r² + η²),
                //   λ_ij = (d / tr M_i + d / tr M_j) / 2   (symmetric in i, j)
                float pair_normalisation = 0.5 * (self_inverse_trace + neighbor_normalisation_and_flag.x);
                float laplacian_factor = fluid_weight * 2.0 * neighbor_mass * pair_normalisation
                    * dot(position_difference_neighbor_to_self, kernel_gradient_raw)
                    / ((self_density + neighbor_density)
                       * (distance * distance + scalar_laplacian_eps_squared));
                float gradient_weight = -fluid_weight * neighbor_volume_dynamic;
                for (uint vec4_index = 0u; vec4_index < SCALAR_VEC4_COUNT; vec4_index++) {
                    vec4 neighbor_scalar = scalar[scalar_index(neighbor_particle_id, vec4_index)]
                                         * scalar_component_mask(vec4_index);
                    vec4 neighbor_diffusivity = scalar_parameters[2u * vec4_index]
                        + scalar_parameters[2u * vec4_index + 1u]
                          * (neighbor_turbulent_viscosity * INVERSE_TURBULENT_SCHMIDT);
                    vec4 pair_diffusivity = self_diffusivity[vec4_index] + neighbor_diffusivity;   // D_i + D_j
                    vec4 scalar_difference = self_scalar[vec4_index] - neighbor_scalar;          // C_i - C_j
                    scalar_rate[vec4_index] += (laplacian_factor * pair_diffusivity) * scalar_difference;
                    if (do_scalar_gradient) {
                        // ∇C_i += V_j (C_j - C_i) ∇W_ij; M_i⁻¹ is applied once
                        // after the loop (linear, so equivalent).
                        vec4 weighted = gradient_weight * scalar_difference;
                        scalar_gradient_x[vec4_index] += weighted * kernel_gradient_raw.x;
                        scalar_gradient_y[vec4_index] += weighted * kernel_gradient_raw.y;
                        scalar_gradient_z[vec4_index] += weighted * kernel_gradient_raw.z;
                        if (USE_SCALAR_BOUNDS_LIMITER) {
                            // a solid neighbour contributes the self value, i.e. nothing
                            vec4 bounds_candidate = mix(self_scalar[vec4_index], neighbor_scalar, fluid_weight);
                            scalar_minimum[vec4_index] = min(scalar_minimum[vec4_index], bounds_candidate);
                            scalar_maximum[vec4_index] = max(scalar_maximum[vec4_index], bounds_candidate);
                        }
                    }
                }
            }
#endif
        }
    }

    // ========================================================================
    // Total acceleration = pressure + viscosity + gravity
    // ========================================================================
    vec3 gravity_vector = vec3(GRAVITY_X, GRAVITY_Y, GRAVITY_Z);
    vec3 total_acceleration = a_pressure + a_viscosity + gravity_vector;

    // ========================================================================
    // Blend PST shift by kernel_sum: interior → main, surface → anti
    //   blend_weight = clamp(kernel_sum, 0, 1)^4
    //   shift = blend · main + (1 - blend) · anti
    //
    // Gated by USE_PST spec const: when false, glslc -O DCE-removes the blend
    // (and earlier the loop-body PST accumulators) so shift = 0 and the kernel
    // does no PST work at all.
    // ========================================================================
    vec3 particle_shift;
    if (USE_PST) {
        float kernel_sum_clamped = clamp(self_kernel_sum, 0.0, 1.0);
        float blend_weight = kernel_sum_clamped * kernel_sum_clamped;
        blend_weight *= blend_weight;  // ^4
        particle_shift = blend_weight * particle_shift_main
                       + (1.0 - blend_weight) * particle_shift_anti;
        if (PST_NEAR_SOLID_MODE == 1u && self_params.kind == MATERIAL_FLUID) {
            float solid_gradient_length = length(solid_kernel_gradient_sum);
            if (solid_gradient_length * delta_x_uniform > 0.01) {
                vec3 solid_normal = solid_kernel_gradient_sum / solid_gradient_length;
                particle_shift -= dot(particle_shift, solid_normal) * solid_normal;
            }
        }
    } else {
        particle_shift = vec3(0.0);
    }

    // ========================================================================
    // Write outputs. acceleration.w carries ω_z (2D vorticity) for render color
    // mode 5 — a free slot (integration reads only acceleration.xyz). shift.w
    // stays reserved (0).
    // ========================================================================
    acceleration[self_particle_id] = vec4(total_acceleration, vorticity_z);
    shift[self_particle_id]        = vec4(particle_shift, 0.0);
#if WITH_THIN_PLATES
    if (thin_plate_first != 0u) {
        thin_plate_reaction[2u * self_particle_id]      = vec4(thin_plate_force, float(thin_plate_first));
        thin_plate_reaction[2u * self_particle_id + 1u] = vec4(self_position, 0.0);
    }
#endif

#if FORCE_WITH_SCALARS
    // ========================================================================
    // Scalar increment for the next predict.comp (2026-09-27):
    //     ΔC = dt · (dC/dt)_diffusion  +  shift · ∇C
    // The shift term uses the same shift that predict adds to the position,
    // so the scalar is interpolated to where the particle is moved.
    // ========================================================================
    if (do_scalar) {
        for (uint vec4_index = 0u; vec4_index < SCALAR_VEC4_COUNT; vec4_index++) {
            vec4 delta = TIMESTEP * scalar_rate[vec4_index];
            if (do_scalar_gradient) {
                // shift · ∇C = shift · (M⁻¹ g) = (M⁻¹ shift) · g for symmetric M⁻¹,
                // g = Σ_j V_j (C_j - C_i) ∇W_ij (raw) accumulated above.
                vec3 corrected_shift = scalar_gradient_matrix * particle_shift;
                delta += corrected_shift.x * scalar_gradient_x[vec4_index]
                       + corrected_shift.y * scalar_gradient_y[vec4_index]
                       + corrected_shift.z * scalar_gradient_z[vec4_index];
            }
            if (USE_SCALAR_BOUNDS_LIMITER && do_scalar_gradient) {
                // Keep C_i + ΔC_i inside [min, max] of self + FLUID neighbours.
                // Clamp the increment itself: forming C_i + ΔC_i first would round
                // away increments below half an ulp of C_i and defeat the Kahan sum
                // (found 2026-09-27 with T4).
                delta = clamp(delta,
                              scalar_minimum[vec4_index] - self_scalar[vec4_index],
                              scalar_maximum[vec4_index] - self_scalar[vec4_index]);
            }
            scalar_delta[scalar_index(self_particle_id, vec4_index)] = delta;
        }
    }
#endif
}
